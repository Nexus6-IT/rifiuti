<?xml version="1.0" encoding="UTF-8"?>
<!--
	RENTRI
	rentri-common-1.0.xsd

	16/04/2024 - Versione 1.0		
	11/09/2024 - Versione 1.0.1 - Modificata la validazione di CodiceFiscale
-->
<xs:schema xmlns:enum="urn:it:rentri:common:1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:it:rentri:common:1.0" elementFormDefault="qualified">
	<xs:simpleType name="IdentificativoRegistro">
		<xs:restriction base="xs:token">
			<xs:pattern value="R[0-9A-Z]{10}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="NumIscrOperatore">
		<xs:restriction base="xs:token">
			<xs:pattern value="OP[0-9A-Z]{13}"/>
		</xs:restriction>
	</xs:simpleType>	
	<xs:simpleType name="NumIscrSito">
		<xs:restriction base="xs:token">
			<xs:pattern value="OP[0-9A-Z]{13}-[A-Z]{2}[0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CodiceFiscale">
		<xs:restriction base="xs:string">
			<xs:minLength value="5"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>