  scadenzaAutorizzazione DateTime? @map("scadenza_autorizzazione") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Fase 2 pezzo 10: ditta e sede predefinita del ruolo (le colonne vecchie sopra sono copia congelata, D6)
  dittaId String @map("ditta_id") @db.Uuid
  sedeId  String @map("sede_id") @db.Uuid
  ditta   Ditta     @relation(fields: [dittaId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "destinatari_ditta_fkey")
  sede    SedeDitta @relation(fields: [sedeId, dittaId, tenantId], references: [id, dittaId, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "destinatari_sede_fkey")

  @@unique([tenantId, dittaId], map: "destinatari_tenant_id_ditta_id_key")
  @@index([tenantId])
  @@index([sedeId], map: "destinatari_sede_id_idx")
  @@map("destinatari")
}

/// Autorizzazione o certificazione dell'impianto del dichiarante.
///
/// Mappa 1:1 la **Scheda SA-AUT (record AU)** del tracciato MUD: va compilata
/// una scheda per ogni autorizzazione o certificazione posseduta dall'impianto
/// che effettua la gestione dei rifiuti. In assenza di autorizzazioni — e per
/// tutti i soggetti estranei alla gestione — nessun record viene emesso.
///
/// È il prerequisito documentato delle schede SA-RIC e dei moduli MG: il
/// tracciato prevede che una SA-RIC presupponga almeno una SA-AUT.
/// Da non confondere con `Destinatario.numeroAutorizzazione`, che è
/// l'autorizzazione di un soggetto TERZO a cui si conferisce il rifiuto.
model AutorizzazioneImpianto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Estremi dell'autorizzazione, o dell'iscrizione per procedura semplificata (alfa 20).
  estremi                   String    @db.VarChar(20)
  dataRilascio              DateTime? @map("data_rilascio") @db.Date
  dataScadenza              DateTime? @map("data_scadenza") @db.Date
  /// 0=ND, 1=Provincia, 2=Regione, 3=Ministero.
  enteAutorizzante          Int       @default(0) @map("ente_autorizzante") @db.SmallInt
  /// 0=ND, 1..6 (6.04/24); 7=bonifiche art.242 c.7, 8=art.191, 9=art.110 c.3 (dal 6.04/25).
  tipoAutorizzazione        Int       @default(0) @map("tipo_autorizzazione") @db.SmallInt
  rinnovoAutocertificazione Boolean   @default(false) @map("rinnovo_autocertificazione")

  /// Operazioni autorizzate, es. ["R3","R4","R13"] / ["D4","D5","D12"].
  // `@default([])` dichiara il default che esiste gia' in produzione
  // (`ARRAY[]::text[]`): un'autorizzazione senza operazioni dichiarate e' un
  // caso legittimo (impianto autorizzato al solo stoccaggio), e l'assenza va
  // rappresentata come lista vuota, mai come NULL.
  operazioniRecupero    String[] @default([]) @map("operazioni_recupero")
  operazioniSmaltimento String[] @default([]) @map("operazioni_smaltimento")

  gestisceVfu       Boolean @default(false) @map("gestisce_vfu")
  gestisceRaee      Boolean @default(false) @map("gestisce_raee")
  /// Autorizzazione EoW (art. 184-ter c.3) — significativa solo per tipo 1, 2, 4, 5.
  autorizzazioneEow Boolean @default(false) @map("autorizzazione_eow")

  /// Capacità autorizzate in tonnellate/anno (num 9 nel tracciato).
  impiantoIncenerimento        Boolean @default(false) @map("impianto_incenerimento")
  capacitaComplessivaTa        Int     @default(0) @map("capacita_complessiva_ta")
  capacitaPericolosiTa         Int     @default(0) @map("capacita_pericolosi_ta")
  capacitaNonPericolosiTa      Int     @default(0) @map("capacita_non_pericolosi_ta")
  impiantoCoincenerimento      Boolean @default(false) @map("impianto_coincenerimento")
  capacitaCoincComplessivaTa   Int     @default(0) @map("capacita_coinc_complessiva_ta")
  capacitaCoincPericolosiTa    Int     @default(0) @map("capacita_coinc_pericolosi_ta")
  capacitaCoincNonPericolosiTa Int     @default(0) @map("capacita_coinc_non_pericolosi_ta")

  /// Certificazioni ambientali.
  emasPrimaRegistrazione  DateTime? @map("emas_prima_registrazione") @db.Date
  emasNumeroRegistrazione String?   @map("emas_numero_registrazione") @db.VarChar(9)
  iso14001Emissione       DateTime? @map("iso14001_emissione") @db.Date

  tenant     Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discariche AutorizzazioneImpiantoDiscarica[]

  // Bersaglio della chiave esterna composta delle discariche.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("autorizzazioni_impianto")
}

/// Discarica dichiarata in una scheda SA-AUT (max 3 per autorizzazione: il
/// record AU prevede esattamente tre blocchi classificazione + capacità residua).
model AutorizzazioneImpiantoDiscarica {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorizzazioneId String @map("autorizzazione_id") @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid

  /// 0=ND, 6=rifiuti pericolosi, 7=rifiuti non pericolosi, 8=rifiuti inerti.
  classificazione   Int @default(0) @db.SmallInt
  /// Capacità residua in metri cubi (num 9).
  capacitaResiduaMc Int @default(0) @map("capacita_residua_mc")

  autorizzazione AutorizzazioneImpianto @relation(fields: [autorizzazioneId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([autorizzazioneId])
  @@map("autorizzazioni_impianto_discariche")
}

// ============================================================================
// PERMISSIONS & ROLES SYSTEM
// ============================================================================

/// Role represents a named collection of permissions within a tenant
model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name         String  @db.VarChar(100)
  description  String? @db.Text
  isSystemRole Boolean @default(false) @map("is_system_role")
  createdBy    String  @map("created_by") @db.Uuid

  // Relationships
  permissions            RolePermission[]
  userRoles              UserRoleAssignment[]
  consultantAssociations ConsultantTenantAssociation[]
  changeHistory          RoleChangeHistory[]
  permissionRequests     PermissionRequest[]

  @@unique([tenantId, name])
  @@index([tenantId, isSystemRole])
  @@index([tenantId])
  @@map("roles")
}

/// Permission represents an atomic action on a resource
model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resource    String  @db.VarChar(50) // "fir", "facility", "report"
  action      String  @db.VarChar(50) // "create", "read", "update", "delete"
