{
  "name": "wasteflow",
  "version": "0.1.0",
  "description": "Piattaforma SaaS gestione rifiuti digitale - MVP TDD-driven",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "backend:dev": "cd apps/backend && npm run start:dev",
    "backend:test": "cd apps/backend && npm run test",
    "backend:test:watch": "cd apps/backend && npm run test:watch",
    "backend:test:cov": "cd apps/backend && npm run test:cov",
    "backend:test:e2e": "cd apps/backend && npm run test:e2e",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=chromium",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test -c e2e/playwright.config.ts --project=chromium --headed",
    "e2e:report": "playwright show-report e2e-report",
    "e2e:prod": "node e2e/scripts/run-against-prod.js"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "rxjs": "~7.8.0"
  },
  "overrides": {
    "rxjs": "$rxjs",
    "multer": "^2.3.0",
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overridesNote": "multer/lodash/js-yaml/express: transitivi di @nestjs/platform-express 10 e @nestjs/swagger 7 (nessuna fix dentro la major Nest 10; le versioni indicate chiudono gli avvisi high rimanendo nella stessa major del pacchetto)."
}
