{
  "name": "rentri-fake",
  "version": "1.0.0",
  "private": true,
  "description": "Fake API RENTRI fedele: rifiuta cio' che RENTRI rifiuterebbe",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand",
    "genera-schema": "node scripts/genera-schema.js",
    "genera-schema:trasmissione-dati": "node scripts/genera-schema.js DatiTrasmissioneFormularioModel src/dominio/schema-trasmissione-dati.ts TRASMISSIONE_DATI",
    "genera-schema:movimento": "node scripts/genera-schema.js MovimentoModel src/dominio/schema-movimento.ts MOVIMENTO dati-registri.yaml",
    "genera-schema:annullamento-movimento": "node scripts/genera-schema.js AnnullamentoMovimentoModel src/dominio/schema-annullamento-movimento.ts ANNULLAMENTO_MOVIMENTO dati-registri.yaml",
    "genera-schema:valida-registro": "node scripts/genera-schema.js ValidaRegistroRequest src/dominio/schema-valida-registro.ts VALIDA_REGISTRO dati-registri.yaml",
    "genera-schema:copia-cartacea": "node scripts/genera-schema.js CopiaCartaceaModel src/dominio/schema-copia-cartacea.ts COPIA_CARTACEA",
    "genera-schema:copia-cartacea-conferma": "node scripts/genera-schema.js CopiaCartaceaConfermaModel src/dominio/schema-copia-cartacea-conferma.ts COPIA_CARTACEA_CONFERMA",
    "genera-schema:copia-digitale": "node scripts/genera-schema.js CopiaDigitaleModel src/dominio/schema-copia-digitale.ts COPIA_DIGITALE",
    "genera-schema:efir": "node scripts/genera-schema.js EfirModel src/dominio/schema-efir.ts EFIR vidimazione-formulari.yaml",
    "genera-schema:blocco": "node scripts/genera-schema.js BloccoModel src/dominio/schema-blocco.ts BLOCCO vidimazione-formulari.yaml"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.5",
    "ajv": "^8.20.0",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "jest": "^29.7.0",
    "js-yaml": "^5.4.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  }
}
