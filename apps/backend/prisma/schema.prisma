  numeroIscrizione String @map("numero_iscrizione") @db.VarChar(50)

  // Sede Legale
  via       String? @db.VarChar(255) @ignore
  civico    String? @db.VarChar(20) @ignore
  cap       String? @db.VarChar(5) @ignore
  comune    String? @db.VarChar(100) @ignore
  provincia String? @db.VarChar(2) @ignore

  // Contacts
  email    String? @db.VarChar(255) @ignore
  telefono String? @db.VarChar(20) @ignore
  pec      String? @db.VarChar(255) @ignore

  /// Scadenza dell'iscrizione all'Albo Gestori Ambientali. Nullable: le
