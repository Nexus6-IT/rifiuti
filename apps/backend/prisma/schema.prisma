  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ragioneSocialeStorica String? @map("ragione_sociale") @db.VarChar(255)
  partitaIVA     String? @map("partita_iva") @db.VarChar(11) @ignore

