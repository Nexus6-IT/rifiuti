  scadenzaIscrizione DateTime? @map("scadenza_iscrizione") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Fase 2 pezzo 10: ditta e sede predefinita del ruolo (le colonne vecchie sopra sono copia congelata, D6)
  dittaId String @map("ditta_id") @db.Uuid
  sedeId  String @map("sede_id") @db.Uuid
  ditta   Ditta     @relation(fields: [dittaId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "trasportatori_ditta_fkey")
  sede    SedeDitta @relation(fields: [sedeId, dittaId, tenantId], references: [id, dittaId, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "trasportatori_sede_fkey")

