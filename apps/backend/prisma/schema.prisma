model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type     NotificationType
  title    String               @db.VarChar(255)
  message  String               @db.Text
  severity NotificationSeverity @default(INFO)

  relatedEntityId   String? @map("related_entity_id") @db.Uuid
  relatedEntityType String? @map("related_entity_type") @db.VarChar(50)
  actionUrl         String? @map("action_url") @db.VarChar(500)

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  // ATTENZIONE — falso positivo noto del differ di Prisma, l'UNICO rimasto
  // dopo la bonifica del 26/07/2026 (v. la migrazione
  // `..._allinea_storia_migrazioni_alla_realta`). `prisma migrate dev`
  // proporra' SEMPRE in coda un
  //   ALTER TABLE "notifications" ALTER COLUMN "expires_at" SET DEFAULT ...
  // anche quando il database ha gia' esattamente questo default. Verificato:
  // ricostruendo il database dalla sola storia delle migrazioni il default
  // risulta presente e identico, e il differ lo ripropone lo stesso; riscriverlo
  // nella forma normalizzata da PostgreSQL (`now() + '30 days'::interval`) non
  // cambia nulla.
  // REGOLA PRATICA: quella singola riga nell'output di `migrate dev` va
  // cancellata a mano. Se ne compare anche solo UNA in piu', NON e' questo caso
  // noto: fermati e verifica, perche' il drift era tornato.
  expiresAt DateTime  @default(dbgenerated("now() + interval '30 days'")) @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  FIR_DEADLINE_APPROACHING
  RENTRI_SYNC_FAILED
  RENTRI_SYNC_SUCCESS
  MUD_DEADLINE_APPROACHING
  SUBSCRIPTION_EXPIRING
  SIGNATURE_REQUIRED
  SYSTEM_ERROR
  AUTORIZZAZIONE_IN_SCADENZA
  CERTIFICATO_RENTRI_IN_SCADENZA
  TRASPORTATORE_ISCRIZIONE_IN_SCADENZA
  DESTINATARIO_AUTORIZZAZIONE_IN_SCADENZA

  @@map("notification_type")
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR

  @@map("notification_severity")
}

/// Primo numero del registro di carico e scarico per registro e anno (decisione C-W-02).
/// Serve a chi arriva da un altro programma a meta' anno: il primo movimento registrato
/// qui prende questo numero, cosi' la numerazione gia' trasmessa al RENTRI prosegue.
/// Si imposta una volta sola, prima del primo movimento dell'anno, sotto lo stesso
/// advisory lock `<registroId>-<anno>` della numerazione. La migration aggiunge
/// CHECK (primo_progressivo >= 1).
model RegistroProgressivoIniziale {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  anno             Int
  primoProgressivo Int      @map("primo_progressivo")
  motivo           String   @db.VarChar(500)
  impostatoDa      String   @map("impostato_da") @db.Uuid
  impostatoIl      DateTime @default(now()) @map("impostato_il")
  /// Registro a cui appartiene il progressivo (Fase 2 pezzo 1): uno per registro e anno.
  registroId       String   @map("registro_id") @db.Uuid

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registro RegistroRifiuti  @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([registroId, anno])
  @@map("registro_progressivi_iniziali")
}

/// Origine di una giacenza di apertura del registro.
enum GiacenzaInizialeProvenienza {
  /// Inserita da un amministratore dall'applicazione (le API scrivono sempre questo valore).
  MANUALE
  /// Riservato all'importazione da altro programma (Fase 3).
  IMPORTAZIONE

  @@map("giacenza_iniziale_provenienza")
}

/// Giacenza di apertura del registro (Fase 2 pezzo 2): quantita' gia' in deposito per registro, CER,
/// stato fisico e unita' da una certa data. Entra nei saldi come un carico del giorno
/// `dataRiferimento`, ma NON e' un movimento: non consuma progressivi e non e' "prodotta" ne'
/// "ricevuta" nel MUD. `cerCode` e' nella forma del catalogo (con "*" se il catalogo lo ha).
/// `origini` e' un array di { anno, protocollo, quantita? } (relazioni iniziali RENTRI, F2-9).
/// La migration aggiunge CHECK (quantita > 0) e, sull'indice unico, NULLS NOT DISTINCT (due
/// aperture con lo stesso stato fisico NULL sono un duplicato): Prisma non la confronta, quindi
/// `migrate diff` resta pulito. Il controllo "una sola apertura per famiglia di unita'" (kg e t
/// sono la stessa famiglia) e' nel servizio, sotto lo stesso advisory lock dello scarico.
model GiacenzaIniziale {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  registroId      String                      @map("registro_id") @db.Uuid
  cerCode         String                      @map("cer_code") @db.VarChar(10)
  statoFisico     String?                     @map("stato_fisico") @db.VarChar(50)
  quantita        Decimal                     @db.Decimal(10, 2)
  unita           String                      @db.VarChar(10)
  dataRiferimento DateTime                    @map("data_riferimento") @db.Date
  origini         Json                        @default("[]")
  provenienza     GiacenzaInizialeProvenienza @default(MANUALE)
  note            String?                     @db.VarChar(500)
  impostatoDa     String                      @map("impostato_da") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registro RegistroRifiuti @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([registroId, cerCode, statoFisico, unita], map: "giacenze_iniziali_registro_cer_stato_unita_key")
  @@index([tenantId])
  @@index([registroId])
  @@map("giacenze_iniziali")
}

model ActivityLog {
