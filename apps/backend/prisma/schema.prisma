model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type     NotificationType
  title    String               @db.VarChar(255)
  message  String               @db.Text
  severity NotificationSeverity @default(INFO)

  relatedEntityId   String? @map("related_entity_id") @db.Uuid
  relatedEntityType String? @map("related_entity_type") @db.VarChar(50)
  actionUrl         String? @map("action_url") @db.VarChar(500)

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  // ATTENZIONE — falso positivo noto del differ di Prisma, l'UNICO rimasto
  // dopo la bonifica del 26/07/2026 (v. la migrazione
  // `..._allinea_storia_migrazioni_alla_realta`). `prisma migrate dev`
  // proporra' SEMPRE in coda un
  //   ALTER TABLE "notifications" ALTER COLUMN "expires_at" SET DEFAULT ...
  // anche quando il database ha gia' esattamente questo default. Verificato:
  // ricostruendo il database dalla sola storia delle migrazioni il default
  // risulta presente e identico, e il differ lo ripropone lo stesso; riscriverlo
  // nella forma normalizzata da PostgreSQL (`now() + '30 days'::interval`) non
  // cambia nulla.
  // REGOLA PRATICA: quella singola riga nell'output di `migrate dev` va
  // cancellata a mano. Se ne compare anche solo UNA in piu', NON e' questo caso
  // noto: fermati e verifica, perche' il drift era tornato.
  expiresAt DateTime  @default(dbgenerated("now() + interval '30 days'")) @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
