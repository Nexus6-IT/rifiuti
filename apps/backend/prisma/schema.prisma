model Trasportatore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ragioneSociale   String @map("ragione_sociale") @db.VarChar(255)
  partitaIVA       String @map("partita_iva") @db.VarChar(11)
  numeroIscrizione String @map("numero_iscrizione") @db.VarChar(50)

  // Sede Legale
  via       String @db.VarChar(255)
  civico    String @db.VarChar(20)
  cap       String @db.VarChar(5)
  comune    String @db.VarChar(100)
  provincia String @db.VarChar(2)

  // Contacts
  email    String? @db.VarChar(255)
  telefono String? @db.VarChar(20)
  pec      String? @db.VarChar(255)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, partitaIVA])
  @@index([tenantId])
  @@map("trasportatori")
}

model Destinatario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ragioneSociale       String @map("ragione_sociale") @db.VarChar(255)
  partitaIVA           String @map("partita_iva") @db.VarChar(11)
  numeroAutorizzazione String @map("numero_autorizzazione") @db.VarChar(50)

  // Sede
  via       String @db.VarChar(255)
  civico    String @db.VarChar(20)
  cap       String @db.VarChar(5)
  comune    String @db.VarChar(100)
  provincia String @db.VarChar(2)

  // Contacts
  email    String? @db.VarChar(255)
  telefono String? @db.VarChar(20)
  pec      String? @db.VarChar(255)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, partitaIVA])
  @@index([tenantId])
  @@map("destinatari")
}

/// Autorizzazione o certificazione dell'impianto del dichiarante.
///
/// Mappa 1:1 la **Scheda SA-AUT (record AU)** del tracciato MUD: va compilata
/// una scheda per ogni autorizzazione o certificazione posseduta dall'impianto
/// che effettua la gestione dei rifiuti. In assenza di autorizzazioni — e per
/// tutti i soggetti estranei alla gestione — nessun record viene emesso.
///
/// È il prerequisito documentato delle schede SA-RIC e dei moduli MG: il
/// tracciato prevede che una SA-RIC presupponga almeno una SA-AUT.
/// Da non confondere con `Destinatario.numeroAutorizzazione`, che è
/// l'autorizzazione di un soggetto TERZO a cui si conferisce il rifiuto.
model AutorizzazioneImpianto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Estremi dell'autorizzazione, o dell'iscrizione per procedura semplificata (alfa 20).
  estremi                   String    @db.VarChar(20)
  dataRilascio              DateTime? @map("data_rilascio") @db.Date
  dataScadenza              DateTime? @map("data_scadenza") @db.Date
  /// 0=ND, 1=Provincia, 2=Regione, 3=Ministero.
  enteAutorizzante          Int       @default(0) @map("ente_autorizzante") @db.SmallInt
  /// 0=ND, 1..6 (6.04/24); 7=bonifiche art.242 c.7, 8=art.191, 9=art.110 c.3 (dal 6.04/25).
  tipoAutorizzazione        Int       @default(0) @map("tipo_autorizzazione") @db.SmallInt
  rinnovoAutocertificazione Boolean   @default(false) @map("rinnovo_autocertificazione")

  /// Operazioni autorizzate, es. ["R3","R4","R13"] / ["D4","D5","D12"].
  // `@default([])` dichiara il default che esiste gia' in produzione
  // (`ARRAY[]::text[]`): un'autorizzazione senza operazioni dichiarate e' un
  // caso legittimo (impianto autorizzato al solo stoccaggio), e l'assenza va
  // rappresentata come lista vuota, mai come NULL.
  operazioniRecupero    String[] @default([]) @map("operazioni_recupero")
  operazioniSmaltimento String[] @default([]) @map("operazioni_smaltimento")

  gestisceVfu       Boolean @default(false) @map("gestisce_vfu")
  gestisceRaee      Boolean @default(false) @map("gestisce_raee")
  /// Autorizzazione EoW (art. 184-ter c.3) — significativa solo per tipo 1, 2, 4, 5.
  autorizzazioneEow Boolean @default(false) @map("autorizzazione_eow")

  /// Capacità autorizzate in tonnellate/anno (num 9 nel tracciato).
  impiantoIncenerimento        Boolean @default(false) @map("impianto_incenerimento")
  capacitaComplessivaTa        Int     @default(0) @map("capacita_complessiva_ta")
  capacitaPericolosiTa         Int     @default(0) @map("capacita_pericolosi_ta")
  capacitaNonPericolosiTa      Int     @default(0) @map("capacita_non_pericolosi_ta")
  impiantoCoincenerimento      Boolean @default(false) @map("impianto_coincenerimento")
  capacitaCoincComplessivaTa   Int     @default(0) @map("capacita_coinc_complessiva_ta")
  capacitaCoincPericolosiTa    Int     @default(0) @map("capacita_coinc_pericolosi_ta")
  capacitaCoincNonPericolosiTa Int     @default(0) @map("capacita_coinc_non_pericolosi_ta")

  /// Certificazioni ambientali.
  emasPrimaRegistrazione  DateTime? @map("emas_prima_registrazione") @db.Date
  emasNumeroRegistrazione String?   @map("emas_numero_registrazione") @db.VarChar(9)
  iso14001Emissione       DateTime? @map("iso14001_emissione") @db.Date

  tenant     Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discariche AutorizzazioneImpiantoDiscarica[]

  @@index([tenantId])
  @@map("autorizzazioni_impianto")
}

/// Discarica dichiarata in una scheda SA-AUT (max 3 per autorizzazione: il
/// record AU prevede esattamente tre blocchi classificazione + capacità residua).
model AutorizzazioneImpiantoDiscarica {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autorizzazioneId String @map("autorizzazione_id") @db.Uuid

  /// 0=ND, 6=rifiuti pericolosi, 7=rifiuti non pericolosi, 8=rifiuti inerti.
  classificazione   Int @default(0) @db.SmallInt
  /// Capacità residua in metri cubi (num 9).
  capacitaResiduaMc Int @default(0) @map("capacita_residua_mc")

  autorizzazione AutorizzazioneImpianto @relation(fields: [autorizzazioneId], references: [id], onDelete: Cascade)

  @@index([autorizzazioneId])
  @@map("autorizzazioni_impianto_discariche")
}

// ============================================================================
// PERMISSIONS & ROLES SYSTEM
// ============================================================================

/// Role represents a named collection of permissions within a tenant
model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name         String  @db.VarChar(100)
  description  String? @db.Text
  isSystemRole Boolean @default(false) @map("is_system_role")
  createdBy    String  @map("created_by") @db.Uuid

  // Relationships
  permissions            RolePermission[]
  userRoles              UserRoleAssignment[]
  consultantAssociations ConsultantTenantAssociation[]
  changeHistory          RoleChangeHistory[]
  permissionRequests     PermissionRequest[]

  @@unique([tenantId, name])
  @@index([tenantId, isSystemRole])
  @@index([tenantId])
  @@map("roles")
}

/// Permission represents an atomic action on a resource
model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resource    String  @db.VarChar(50) // "fir", "facility", "report"
  action      String  @db.VarChar(50) // "create", "read", "update", "delete"
  scope       String  @db.VarChar(50) // "own", "facility", "all"
  description String  @db.Text
  isSensitive Boolean @default(false) @map("is_sensitive")
  module      String  @db.VarChar(50) // "FIR", "Facility", "User", "Report", etc.

  // Relationships
  roles    RolePermission[]
  policies PermissionPolicy[]

  @@unique([resource, action, scope])
  @@index([module])
  @@index([resource])
  @@map("permissions")
}

/// UserRoleAssignment links users to roles with optional facility scoping
model UserRoleAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedBy String    @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  facilityIds      Json?   @map("facility_ids") // Array of facility IDs for scope="facility"
  isDelegated      Boolean @default(false) @map("is_delegated")
  delegationReason String? @map("delegation_reason") @db.Text

  // Relationships
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId, tenantId, expiresAt])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// PermissionPolicy defines ABAC rules for fine-grained access control
model PermissionPolicy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  policyName       String  @db.VarChar(100)
  policyDefinition Json    @map("policy_definition") // ABAC rules (conditions, attributes)
  evaluationOrder  Int     @default(0) @map("evaluation_order")
  isActive         Boolean @default(true) @map("is_active")
  version          Int     @default(1)

  // Relationships
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@index([isActive, evaluationOrder])
  @@map("permission_policies")
}

/// PermissionAuditLog records every permission check for compliance (10-year retention)
model PermissionAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  spidFiscalCode    String   @map("spid_fiscal_code") @db.VarChar(16)
  actionAttempted   String   @map("action_attempted") @db.VarChar(255)
  resourceType      String   @map("resource_type") @db.VarChar(50)
  resourceId        String?  @map("resource_id") @db.Uuid
  decision          String   @db.VarChar(20) // "ALLOW", "DENY"
  evaluatedPolicies Json?    @map("evaluated_policies")
  contextAttributes Json?    @map("context_attributes")
  timestamp         DateTime @default(now())
  sessionId         String   @map("session_id") @db.VarChar(100)

  // Cryptographic chaining for tamper detection
  previousEntryHash String? @map("previous_entry_hash") @db.VarChar(64)
  currentHash       String  @map("current_hash") @db.VarChar(64)

  @@index([tenantId, userId])
  @@index([timestamp])
  @@index([resourceType, resourceId])
  @@index([decision])
  @@map("permission_audit_logs")
}

/// RoleChangeHistory tracks all role modifications for audit trail
model RoleChangeHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String?  @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  entityType String   @db.VarChar(50) // "Role", "UserRole", "Permission"
  entityId   String   @map("entity_id") @db.Uuid
  changeType String   @map("change_type") @db.VarChar(50) // "CREATED", "UPDATED", "DELETED", "ASSIGNED", "REVOKED"
  changedBy  String   @map("changed_by") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?  @db.Text
  timestamp  DateTime @default(now())

  // Relationships
  role Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([roleId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("role_change_history")
}

/// ResourceOwnership tracks which users own specific resources
/// ResourceOwnership tracks assignments of resources to users
/// T184: Extended for User Story 6 - Task Assignment Automation
/// Supports vehicle, facility, zone, and route assignments with metadata
model ResourceOwnership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Core fields
  userId       String @map("user_id") @db.Uuid // User who owns/is assigned the resource
  tenantId     String @map("tenant_id") @db.Uuid
  resourceType String @db.VarChar(50) // "vehicle", "facility", "zone", "route"
  resourceId   String @map("resource_id") @db.Uuid

  // Assignment tracking
  assignedBy String   @map("assigned_by") @db.Uuid // User ID who made the assignment
  assignedAt DateTime @default(now()) @map("assigned_at")

  // Expiration and deactivation
  expiresAt        DateTime? @map("expires_at")
  isActive         Boolean   @default(true) @map("is_active")
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason") @db.Text
  reason           String?   @db.Text // Assignment reason/notes

  // Metadata (JSON) - stores certifications, capacity, zone info
  // Example: { "certifications": ["ADR", "Hazmat"], "capacity": 1500, "zone": "North" }
  metadata Json?

  // Legacy field for backward compatibility
  facilityId String? @map("facility_id") @db.Uuid

  @@unique([userId, resourceType, resourceId, isActive], name: "unique_active_assignment")
  @@index([userId, tenantId])
  @@index([resourceId, tenantId])
  @@index([tenantId, resourceType, isActive])
  @@index([tenantId, isActive, expiresAt])
  @@map("resource_ownership")
}

/// TemporaryPermissionGrant allows time-limited permission elevation
model TemporaryPermissionGrant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions           Json // Array of permission strings ["fir:create:all", "report:export:all"]
  startTime             DateTime  @map("start_time")
  endTime               DateTime  @map("end_time")
  grantedBy             String    @map("granted_by") @db.Uuid
  businessJustification String    @map("business_justification") @db.Text
  autoRevoked           Boolean   @default(false) @map("auto_revoked")
  revokedAt             DateTime? @map("revoked_at")

  @@index([userId, tenantId])
  @@index([endTime])
  @@map("temporary_permission_grants")
}

/// ConsultantTenantAssociation links consultant users to multiple client tenants
model ConsultantTenantAssociation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultantUserId String   @map("consultant_user_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  addedBy   String    @map("added_by") @db.Uuid
  addedAt   DateTime  @default(now()) @map("added_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")

  // Relationships
  role Role @relation(fields: [roleId], references: [id])

  @@unique([consultantUserId, tenantId])
  @@index([consultantUserId])
  @@index([tenantId])
  @@index([isActive])
  @@map("consultant_tenant_associations")
}

/// PermissionRequest allows users to request permission elevation
model PermissionRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  requestedRoleId String?  @map("requested_role_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedPermissions  Json?     @map("requested_permissions") // Array of permission strings
  businessJustification String    @map("business_justification") @db.Text
  duration              Int? // Duration in hours
  status                String    @default("PENDING") @db.VarChar(20) // "PENDING", "APPROVED", "DENIED"
  reviewedBy            String?   @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime? @map("reviewed_at")
  denialReason          String?   @map("denial_reason") @db.Text

  // Relationships
  requestedRole Role? @relation(fields: [requestedRoleId], references: [id])

  @@index([userId, tenantId])
  @@index([status])
  @@map("permission_requests")
}

/// RolePermission junction table linking roles to permissions
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String   @map("granted_by") @db.Uuid

  // Relationships
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// AbacPolicy represents Attribute-Based Access Control policies
/// T222: Phase 10 - ABAC Policy Engine
model AbacPolicy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name         String           @unique @db.VarChar(100)
  resourceType String           @map("resource_type") @db.VarChar(50) // "fir", "facility", "report"
  effect       AbacPolicyEffect @default(ALLOW)
  conditions   Json // JSON structure: { operator: "AND", rules: [...] }
  priority     Int              @default(100)
  isActive     Boolean          @default(true) @map("is_active")
  description  String?          @db.Text
  createdBy    String           @map("created_by") @db.Uuid

  @@index([resourceType, isActive, priority])
  @@index([isActive, priority])
  @@map("abac_policies")
}

enum AbacPolicyEffect {
  ALLOW
  DENY

  @@map("abac_policy_effect")
}

/// Contratto di gestione rifiuti tra produttore e controparte
/// (trasportatore/smaltitore/intermediario). Supporta più modelli di pricing e
/// un workflow di stato; abilita l'auto-compilazione dei FIR da contratto
/// attivo. Tenant-scoped. (MVP: billing/firma/AI/marketplace sono follow-up.)
model Contract {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contractNumber String @map("contract_number") @db.VarChar(50)

  // Parti (riferimenti al registro anagrafiche)
  producerId       String           @map("producer_id") @db.Uuid
  counterpartyId   String           @map("counterparty_id") @db.Uuid
  counterpartyType CounterpartyType @map("counterparty_type")

  contractType ContractType @map("contract_type")
  description  String?      @db.Text
  cerCodes     String[]     @map("cer_codes") // CER coperti dal contratto

  // Pricing
  pricingModel  PricingModel @map("pricing_model")
  basePrice     Decimal?     @map("base_price") @db.Decimal(10, 2)
  unitOfMeasure String       @default("kg") @map("unit_of_measure") @db.VarChar(10)
  pricingConfig Json?        @map("pricing_config") // tier/zone/ecc.

  // Termini
  startDate         DateTime  @map("start_date")
  endDate           DateTime? @map("end_date")
  durationMonths    Int?      @map("duration_months")
  autoRenew         Boolean   @default(false) @map("auto_renew")
  renewalNoticeDays Int       @default(60) @map("renewal_notice_days")

  // Pagamento
  paymentTerms     String @default("net_30") @map("payment_terms") @db.VarChar(20)
  billingFrequency String @default("monthly") @map("billing_frequency") @db.VarChar(20)

  status ContractStatus @default(DRAFT)

  @@unique([tenantId, contractNumber])
  @@index([tenantId, status])
  @@index([tenantId, producerId])
  @@map("contracts")
}

enum CounterpartyType {
  TRANSPORTER
  DISPOSER
  BROKER

  @@map("counterparty_type")
}

enum ContractType {
  WASTE_DISPOSAL
  WASTE_TRANSPORT
  FULL_SERVICE
  FRAMEWORK

  @@map("contract_type")
}

enum PricingModel {
  FLAT_RATE
  PAY_PER_LIFT
  PAY_BY_WEIGHT
  PAY_BY_VOLUME
  ZONE_BASED
  TIERED_VOLUME
  MINIMUM_GUARANTEE
  HYBRID

  @@map("pricing_model")
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED

  @@map("contract_status")
}

/// Movimento del registro cronologico di carico/scarico rifiuti
/// (art. 190 D.Lgs 152/2006, DM 59/2023). I CARICO incrementano la giacenza in
/// deposito temporaneo, gli SCARICO la decrementano (tipicamente collegati a
/// un FIR). Base per il calcolo giacenze, monitoraggio deposito temporaneo e
/// export del registro. Vidimazione digitale tramite hash SHA-256 dei campi
/// chiave (entryHash), obbligatoria dal 13/02/2025 per soggetti RENTRI.
model WasteMovement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Numero progressivo dell'annotazione per tenant/anno (art. 190 D.Lgs 152/2006).
  /// Assegnato automaticamente in sequenza — mai modificabile post-registrazione.
  progressiveNumber Int @map("progressive_number")
  /// Anno solare del progressivo (per il reset annuale).
  progressiveYear   Int @map("progressive_year")

  type WasteMovementType

  /// Data effettiva dell'operazione di carico/scarico.
  movementDate     DateTime @map("movement_date")
  /// Data di annotazione nel registro. Per legge: entro 10 gg lavorativi per
  /// produttori (art. 190 c. 1 lett. a); entro 2 gg lavorativi per gestori
  /// impianti di recupero/smaltimento (art. 190 c. 1 lett. d).
  registrationDate DateTime @default(now()) @map("registration_date")

  /// Causale specifica del movimento.
  /// CARICO: PRODUZIONE_INTERNA | INGRESSO_ESTERNO | RICLASSIFICAZIONE | RECUPERO_PARZIALE | ALTRO_CARICO
  /// SCARICO: CONFERIMENTO_TRASPORTATORE | AVVIO_RECUPERO | AVVIO_SMALTIMENTO | CESSIONE | RICLASSIFICAZIONE | ALTRO_SCARICO
  causale String @db.VarChar(100)

  /// Codice CER (formato canonico "NN NN NN" o "NN NN NN*" per pericolosi, max 10 char).
  cerCode          String  @map("cer_code") @db.VarChar(10)
  wasteDescription String? @map("waste_description") @db.VarChar(500)
  quantity         Decimal @db.Decimal(10, 2)
  unit             String  @default("KG") @db.VarChar(10)

  /// Stato fisico del rifiuto (Solido/Liquido/Fangoso/Gassoso/Polvere/Misto).
  wastePhysicalState String? @map("waste_physical_state") @db.VarChar(50)
  /// Caratteristiche di pericolo HP (es. "HP4,HP14") — obbligatorio per rifiuti pericolosi.
  wasteHazardClasses String? @map("waste_hazard_classes") @db.VarChar(100)
  /// Codice operazione di destinazione R/D (es. "R1", "D13") — All. B/C D.Lgs 152/2006.
  operationCode      String? @map("operation_code") @db.VarChar(10)

  /// Denominazione della controparte (cedente/produttore per CARICO; destinatario per SCARICO).
  counterpartName    String? @map("counterpart_name") @db.VarChar(255)
  /// Indirizzo impianto/sede della controparte.
  counterpartAddress String? @map("counterpart_address") @db.VarChar(500)

  /// SCARICO: FIR collegato (uscita verso trasportatore/destinatario).
  firId String? @map("fir_id") @db.Uuid

  /// Utente (operatore) che ha registrato l'annotazione.
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid

  /// Hash SHA-256 dei campi chiave dell'annotazione (vidimazione digitale, DM 59/2023).
  /// Formato: SHA-256 hex di "{tenantId}|{progressiveYear}|{progressiveNumber}|{type}|{cerCode}|{quantity}|{movementDate}|{causale}"
  entryHash String @default("") @map("entry_hash") @db.VarChar(64)

  notes String? @db.Text

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedByUser User?  @relation("RecordedMovements", fields: [recordedByUserId], references: [id])

  @@unique([tenantId, progressiveYear, progressiveNumber])
  @@index([tenantId, cerCode])
  @@index([tenantId, movementDate])
  @@index([tenantId, type])
  @@index([firId])
  @@map("waste_movements")
}

enum WasteMovementType {
  CARICO
  SCARICO

  @@map("waste_movement_type")
}

/// Credenziale RENTRI per-tenant (Modello di Interoperabilità AgID).
/// Ogni operatore (tenant) ha il PROPRIO certificato di interoperabilità: le
/// chiamate API RENTRI vengono firmate per conto di quel tenant. La chiave
/// privata è cifrata a riposo (AES-256-GCM, vedi rentri-crypto.util.ts) — mai
/// in chiaro nel DB. Un solo set di credenziali per tenant.
model RentriCredential {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Identificativo operatore/client (iss/sub della client_assertion).
  clientId       String  @map("client_id") @db.VarChar(255)
  /// Certificato X.509 in PEM (per x5c). Non sensibile come la chiave.
  certificatePem String  @map("certificate_pem") @db.Text
  /// Chiave privata PEM CIFRATA (formato iv:tag:ciphertext base64).
  privateKeyEnc  String  @map("private_key_enc") @db.Text
  /// Algoritmo di firma JOSE: RS256 (cert RSA) | ES256 (cert EC).
  algorithm      String  @default("RS256") @db.VarChar(10)
  /// Ambiente RENTRI dichiarato per la credenziale: demo | live.
  environment    String  @default("demo") @db.VarChar(10)
  /// DEPRECATO (2026-07-26, R2 multi-sede): un'azienda con più unità locali
  /// operative su RENTRI non trova posto in un singolo valore per tenant.
  /// Il modello attuale è `RentriUnitaLocale` (figlia del tenant, con flag
  /// `principale`). Questo campo resta per compatibilità finché la
  /// migrazione del dato esistente (prima unità locale = principale) non è
  /// verificata in produzione — stessa cautela già adottata con
  /// `rentriProtocolNumber`. Non scrivere più qui: nuove sedi vanno create
  /// in `RentriUnitaLocale`. Formato storico (se presente):
  /// ^OP[0-9]{4}[A-Z0-9]{3}[0-9]{6}-[A-Z]{2}[0-9]{4}$ (formulari.yaml riga 684).
  numIscrSito    String? @map("num_iscr_sito") @db.VarChar(30)

  /// Numero di iscrizione dell'OPERATORE (non dell'unità locale), rilasciato
  /// da RENTRI all'iscrizione: parametro `num_iscr` di
  /// `GET /anagrafiche/v1.0/operatore/{num_iscr}/siti` (R4 Task 3). Nessun
  /// pattern impostato: `anagrafiche.yaml` lo dichiara `string` semplice,
  /// senza vincoli di formato (a differenza di `num_iscr_sito`, che
  /// `formulari.yaml` vincola con una regex — un vincolo specifico di quel
  /// contratto, non di questo campo).
  numIscrOperatore    String?   @map("num_iscr_operatore") @db.VarChar(30)
  /// Ultimo allineamento riuscito delle unità locali del tenant da
  /// `GET /operatore/{num_iscr}/siti` (R4 Task 3). Cache TTL: l'apertura
  /// della sezione «Unità locali» non richiama l'ente se questo timestamp è
  /// più recente di un'ora (v. `SincronizzaSitiUseCase`) — evita di
  /// contattare RENTRI a ogni apertura pagina per un dato che cambia solo per
  /// iniziativa dell'azienda (nuova sede, variazione), non per un ciclo
  /// dell'ente.
  sitiSincronizzatiAl DateTime? @map("siti_sincronizzati_al")

  /// Identificativo delle credenziali di firma remota RENTRI (`credentials_id`,
  /// API "ca-rentri" — R3 Task 3), create tramite il boarding umano
  /// (QR Code + PIN dall'area Operatori del portale, non automatizzabile).
  /// Nullable: un tenant può avere l'interoperabilità configurata senza aver
  /// ancora fatto il boarding della firma remota (il ciclo di accettazione/
  /// annullamento resta bloccato allo stato Firma* finché non lo fa).
  ///
  /// Sta QUI e non in una tabella figlia: `RentriCredential` è già "una riga
  /// di configurazione RENTRI per tenant", e il certificato di firma remota
  /// (sigillo M.O. 16) è riferito all'OPERATORE — stessa granularità e stesso
  /// ciclo di vita del resto della riga. La motivazione che rese necessaria
  /// `RentriUnitaLocale` ("un'azienda ha PIÙ sedi") non si applica qui.
  ///
  /// Nessun pattern: il formato di `credentials_id` non è documentato da
  /// alcuna fonte ufficiale — una regex inventata rifiuterebbe valori
  /// legittimi. Unico vincolo applicativo: non vuoto se valorizzato.
  credentialsIdFirmaRemota String? @map("credentials_id_firma_remota") @db.VarChar(255)

  @@map("rentri_credentials")
}

/// Unità locale RENTRI di un tenant (figlia del tenant, non del certificato:
/// un'azienda può avere più sedi operative iscritte a RENTRI, ciascuna col
/// proprio `numIscrSito`, mentre il certificato di interoperabilità
/// (RentriCredential) resta uno per tenant).
///
/// `principale`: chi ha una sola sede non deve scegliere nulla — il
/// comportamento resta quello di prima del multi-sede; chi ne ha più d'una
/// sceglie esplicitamente quale usare di default. Vincolo di esattamente una
/// principale per tenant enforced a livello applicativo + indice unico
/// parziale (vedi migrazione `WHERE principale = true`).
///
/// `attiva`: una sede può cessare l'attività senza che spariscano i
/// formulari già agganciati che la referenziano (mai cancellazione fisica
/// per una sede con storico).
///
/// Popolamento: in R2 è inserimento manuale dall'amministratore; il client
/// anagrafiche di R4 (`GET /operatore/{num_iscr}/siti`) potrà popolare questa
/// tabella automaticamente senza cambiarne la forma.
model RentriUnitaLocale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Numero di iscrizione dell'unità locale RENTRI (formato
  /// ^OP[0-9]{4}[A-Z0-9]{3}[0-9]{6}-[A-Z]{2}[0-9]{4}$, formulari.yaml riga 684).
  numIscrSito   String  @map("num_iscr_sito") @db.VarChar(30)
  /// Denominazione leggibile scelta dall'operatore (es. "Sede di Milano"),
  /// per farla scegliere senza dover riconoscere il codice numIscrSito.
  denominazione String  @db.VarChar(255)
  /// Sede di default per il tenant. Esattamente una per tenant (vedi indice
  /// unico parziale nella migrazione).
  principale    Boolean @default(false)
  /// Sede operativa. false quando la sede ha cessato l'attività: i formulari
  /// già agganciati alla sede restano validi, la sede esce solo dalle scelte
  /// per nuovi agganci.
  attiva        Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numIscrSito])
  @@index([tenantId])
  @@map("rentri_unita_locali")
}

/// Log di sincronizzazione RENTRI: un record per ogni tentativo di
/// trasmissione di un FIR verso l'ente (audit trail immutabile, mai
/// aggiornato né cancellato — vedi RENTRISyncLogRepository.update/delete).
/// Nome del modello volutamente `RENTRISyncLog` (non `RentriSyncLog`): Prisma
/// genera l'accessor del client abbassando solo la prima lettera del nome
/// modello, quindi `RENTRISyncLog` → `prisma.rENTRISyncLog`, che è esattamente
/// ciò che rentri-sync-log.repository.ts si aspetta nelle chiamate commentate.
model RENTRISyncLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firId     String   @map("fir_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  status  RENTRISyncLogStatus
  attempt Int

  /// Origine del tentativo registrato da questa riga (R5 Task 4): TRASMISSIONE
  /// per il flusso normale (SyncFIRToRENTRIUseCase e affini, valore di
  /// default per non richiedere una migrazione dati sulle righe esistenti),
  /// RICONCILIAZIONE per un controllo periodico di allineamento
  /// (RiconciliaStatoRentriUseCase). Senza questo campo un audit/contestazione
  /// non potrebbe distinguere "abbiamo trasmesso questo FIR" da "abbiamo
  /// solo verificato che l'ente lo vedesse ancora allineato".
  origine RENTRISyncLogOrigine @default(TRASMISSIONE) @map("origine")

  /// Payload della richiesta inviata a RENTRI (JSON xFIR), per audit/debug.
  requestPayload  String  @map("request_payload") @db.Text
  responsePayload String? @map("response_payload") @db.Text

  errorMessage String? @map("error_message") @db.Text
  errorCode    String? @map("error_code") @db.VarChar(100)

  /// Numero/protocollo restituito dall'ente in caso di esito SUCCESS di
  /// *questo* tentativo (non necessariamente il numero_fir stabile: dipende
  /// da cosa l'API RENTRI restituisce per l'operazione tentata).
  protocolNumber String? @map("protocol_number") @db.VarChar(100)

  syncedAt   DateTime? @map("synced_at")
  durationMs Int?      @map("duration_ms")

  fir FIR @relation(fields: [firId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([firId])
  @@index([status])
  @@index([createdAt])
  @@map("rentri_sync_logs")
}

enum RENTRISyncLogStatus {
  PENDING
  SUCCESS
  FAILURE

  @@map("rentri_sync_log_status")
}

/// V. commento sul campo RENTRISyncLog.origine.
enum RENTRISyncLogOrigine {
  TRASMISSIONE
  RICONCILIAZIONE

  @@map("rentri_sync_log_origine")
}
