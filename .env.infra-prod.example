# ============================================================================
# .env di PRODUZIONE di rifiuti sul server infra-prod (<root>/.env.prod, modo 600)
# ----------------------------------------------------------------------------
# In produzione lo genera il ruolo app_layout di infra-prod da vault_apps.rifiuti.env:
# questo file elenca TUTTE le chiavi (nessun segreto vero). Formato: NOME=valore, un valore
# per riga, niente a capo; leggibile sia da bash sia da `docker compose --env-file`.
# Password: solo A-Za-z0-9 _ . - (minimo 16): openssl rand -hex 32. Controllo: scripts/infra-prod/validate-env.sh
# ============================================================================

# --- Immagini (TAG lo riscrive scripts/infra-prod/deploy.sh: sha-<7+ hex>, mai latest) ---
REGISTRY=gitea.tail8be933.ts.net/graziano
TAG=sha-0000000

# --- Database (Postgres 16 nel compose) ---
DB_NAME=wasteflow_prod
DB_USER=wasteflow
DB_PASSWORD=CAMBIA_openssl_rand_hex_32
# Ruoli RLS (tutti e tre o nessuno): l'app usa wasteflow_app (NOBYPASSRLS), i job wasteflow_sistema.
DB_APP_USER=wasteflow_app
DB_APP_PASSWORD=CAMBIA_openssl_rand_hex_32
DB_SISTEMA_USER=wasteflow_sistema
DB_SISTEMA_PASSWORD=CAMBIA_openssl_rand_hex_32
# Per gli exporter di infra-prod (stesso valore di DB_NAME/DB_USER: il ruolo monitoring legge queste chiavi dal vault)
DATABASE_NAME=wasteflow_prod
DATABASE_USER=wasteflow
# Password dell'utente `postgres_exporter` (creato dal ruolo monitoring, non dall'app)
MONITORING_PG_PASSWORD=CAMBIA_openssl_rand_hex_32

# --- Redis ---
REDIS_PASSWORD=CAMBIA_openssl_rand_hex_32
REDIS_CLUSTER_NODES=redis:6379

# --- Sicurezza applicativa ---
JWT_SECRET=CAMBIA_openssl_rand_hex_32
JWT_REFRESH_SECRET=CAMBIA_openssl_rand_hex_32
PERMISSION_CACHE_HMAC_SECRET=CAMBIA_openssl_rand_hex_32
# Bearer di /metrics (il backend risponde 404 senza token); lo stesso valore va in apps.yml metrics.token_var
METRICS_TOKEN=CAMBIA_openssl_rand_hex_32
# Cifratura a riposo dei certificati RENTRI per azienda: NON ruotare senza migrare i dati, e nel backup dei segreti
RENTRI_CREDENTIAL_ENC_KEY=CAMBIA_openssl_rand_hex_32
SIGNATURE_PROVIDER=sandbox
TSA_PROVIDER=mock
RENTRI_REGISTRO_INVII_ATTIVI=true
MODULI_BACKEND_MODALITA=registra

# --- URL pubblici (dominio del server nuovo: nessun default nel compose) ---
FRONTEND_URL=https://<dominio-app>
PUBLIC_URL=https://<dominio-app>
ALLOWED_ORIGINS=https://<dominio-app>,https://auth.<dominio-server>

# --- Keycloak DEL SERVER, realm dedicato ---
KEYCLOAK_URL=https://auth.<dominio-server>
KEYCLOAK_REALM=rifiuti
KEYCLOAK_CLIENT_ID=rifiuti-admin
KEYCLOAK_CLIENT_SECRET=CAMBIA_secret_del_service_account
SPID_IDP_ENTRY_POINT=https://auth.<dominio-server>/realms/rifiuti/protocol/saml
SPID_ENTITY_ID=rifiuti
SPID_CALLBACK_URL=https://<dominio-app>/api/v1/auth/spid/callback
SPID_IDP_CERT=CAMBIA_certificato_di_firma_del_realm_in_base64_su_una_riga
DEFAULT_TENANT_ID=CAMBIA_uuid_del_tenant_predefinito

# --- Mail (porta 465: la 587 e' spesso bloccata) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CAMBIA_indirizzo
SMTP_PASSWORD=CAMBIA_app_password
EMAIL_FROM=CAMBIA_stesso_indirizzo_di_SMTP_USER
ACCESS_REQUEST_NOTIFY_EMAIL=CAMBIA_destinatario_richieste_accesso

# --- Osservabilita' ---
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Backup (letti da ops/backup-offsite.sh e dal wrapper di infra-prod; offsite: gestito dal ruolo offsite) ---
BACKUP_ALERT_EMAIL=root
