// Prisma schema for WasteFlow
// Multi-tenant architecture with Row-Level Security (RLS)

generator client {
  provider        = "prisma-client-js"
  // NB: `multiSchema` rimosso — era abilitato ma non usato (nessun @@schema /
  // datasource.schemas). Con un singolo schema `public` faceva generare a
  // `prisma migrate dev` un drop/recreate totale invece di ALTER incrementali,
  // rompendo ogni migrazione successiva alla baseline.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ============================================================================
// MULTI-TENANT CORE
// ============================================================================

/// Tenant represents an organization (company) using the system
/// Each tenant is isolated via Row-Level Security policies
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Company identification
  partitaIva                  String  @unique @map("partita_iva") @db.VarChar(11)
  codiceFiscale               String? @map("codice_fiscale") @db.VarChar(16)
  ragioneSociale              String  @map("ragione_sociale") @db.VarChar(255)
  pec                         String? @db.VarChar(255)
  telefono                    String? @db.VarChar(20)
  // Codice attività economica ISTAT (ATECO 2007), per il MUD. 6 cifre senza punti.
  atecoCode                   String? @map("ateco_code") @db.VarChar(10)
  // Dati per il MUD (dichiarante)
  reaNumber                   String? @map("rea_number") @db.VarChar(9)
  numeroAddetti               Int?    @map("numero_addetti")
  legaleRappresentanteNome    String? @map("legale_rappresentante_nome") @db.VarChar(25)
  legaleRappresentanteCognome String? @map("legale_rappresentante_cognome") @db.VarChar(25)

  // Address (opzionale nel DB: il signup self-service non raccoglie questi campi;
  // i DTO admin continuano a richiedere questi valori per la creazione manuale)
  address    String? @db.VarChar(255)
  civico     String? @db.VarChar(10)
  city       String? @db.VarChar(100)
  province   String? @db.VarChar(2)
  postalCode String? @map("postal_code") @db.VarChar(5)
  country    String  @default("IT") @db.VarChar(2)

  // Subscription management
  subscriptionTier   SubscriptionTier   @default(TRIAL) @map("subscription_tier")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  subscriptionStart  DateTime           @default(now()) @map("subscription_start")
  subscriptionEnd    DateTime?          @map("subscription_end")

  // Usage limits
  firLimitPerMonth Int @default(100) @map("fir_limit_per_month")
  userLimitTotal   Int @default(5) @map("user_limit_total")

  // Feature flag effettivi (array di chiavi feature abilitate). Se null si
  // derivano dal piano (subscriptionTier); se valorizzato e' un override admin.
  featureFlags Json? @map("feature_flags")

  // Integrazione Stripe (SaaS billing). Nullable: null finché il tenant non ha
  // mai avviato un checkout. ATTIVARE: impostare STRIPE_SECRET_KEY in .env.
  stripeCustomerId     String? @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String? @map("stripe_subscription_id") @db.VarChar(255)

  // Admin proprietario (chi ha creato l'azienda in self-service); null se creata
  // dal super admin. Usato per la quota aziende per-admin e per la lista "le mie aziende".
  ownerUserId String? @map("owner_user_id") @db.Uuid

  /// Azienda madre del gruppo. null = azienda madre (radice, titolare del
  /// contratto); valorizzata = azienda figlia. Gerarchia a UN SOLO livello:
  /// una figlia non puo' avere figlie (vincolo applicativo, v. TenantService).
  ///
  /// Le figlie restano tenant a tutti gli effetti: ereditano immutato
  /// l'isolamento (TenantContext + estensione RLS) e hanno ciascuna la propria
  /// RentriCredential. Il contratto (piano, limiti, feature, Stripe) si legge
  /// invece SEMPRE risalendo alla radice: v. ContrattoGruppoService.
  parentTenantId String? @map("parent_tenant_id") @db.Uuid

  /// Quante aziende figlie puo' avere questo gruppo. Solo sulla radice.
  /// null = nessun limite di gruppo: vale il vecchio `User.companyLimit` di
  /// chi crea (retrocompatibilita' per i tenant esistenti).
  aziendeLimit Int? @map("aziende_limit")

  // Modalità di aggancio dei FIR ai formulari RENTRI per questo tenant.
  // Default MANUALE: nessun tenant ha oggi un certificato RENTRI valido
  // configurato, e una trasmissione automatica verso l'ente da parte di
  // un'azienda che non se l'aspetta è un rischio normativo peggiore di una
  // mancata trasmissione. Il tenant passa ad AUTOMATICA/IBRIDA solo con
  // un'azione esplicita, dopo aver configurato la credenziale (RentriCredential).
  rentriModalitaLegame RentriModalitaLegame @default(MANUALE) @map("rentri_modalita_legame")

  // Azienda non tenuta alla presentazione del MUD (A-W-10, come il flag MUD S/N di
  // WinWaste). Lo imposta un amministratore dell'azienda (PUT mud/obbligo): niente
  // promemoria né scadenze del MUD; il file si può generare comunque, con un avviso.
  // Motivo, data e utente sono valorizzati solo con il flag attivo.
  mudNonDovuto       Boolean   @default(false) @map("mud_non_dovuto")
  mudNonDovutoMotivo String?   @map("mud_non_dovuto_motivo") @db.VarChar(500)
  mudNonDovutoIl     DateTime? @map("mud_non_dovuto_il")
  mudNonDovutoDa     String?   @map("mud_non_dovuto_da") @db.Uuid

  // Relationships
  users                  User[]
  firs                   FIR[]
  mudReports             MUDReport[]
  companyTemplates       CompanyTemplate[]
  notifications          Notification[]
  produttori             Produttore[]
  trasportatori          Trasportatore[]
  destinatari            Destinatario[]
  autorizzazioniImpianto AutorizzazioneImpianto[]
  wasteMovements         WasteMovement[]
  rentriUnitaLocali      RentriUnitaLocale[]
  rentriNumeriVidimati   RentriNumeroVidimato[]
  registroProgressiviIniziali RegistroProgressivoIniziale[]
  registriRifiuti       RegistroRifiuti[]
  giacenzeIniziali      GiacenzaIniziale[]
  causaliRegistroAzienda CausaleRegistroAzienda[]
  soglieDeposito        SogliaDepositoTemporaneo[]
  strumentiPesa         StrumentoPesa[]
  automezzi             Automezzo[]
  accessiPesa           AccessoPesa[]
  pesate                Pesata[]
  rettifichePeso        RettificaPeso[]
  allegatiPesa          AllegatoPesa[]
  collegamentiAccesso   CollegamentoAccesso[]
  madre                 Tenant?                  @relation("GruppoAziende", fields: [parentTenantId], references: [id], onDelete: Restrict)
  figlie                 Tenant[]                 @relation("GruppoAziende")
  // Fase 2 pezzo 10
  ditte                  Ditta[]
  sediDitte              SedeDitta[]

  // Indici presenti in produzione ma non piu' dichiarati nel modello: la
  // dichiarazione era andata persa, non l'indice. `stripe_customer_id` e' il
  // criterio di lookup dei webhook Stripe (percorso caldo, chiamato dall'esterno
  // a ogni evento di fatturazione); `owner_user_id` serve la risoluzione del
  // tenant a partire dall'utente proprietario. Ridichiararli qui evita che il
  // prossimo `prisma migrate dev` proponga di cancellarli.
  @@index([ownerUserId])
  @@index([stripeCustomerId])
  @@index([parentTenantId])
  @@map("tenants")
}

enum SubscriptionTier {
  TRIAL
  PROFESSIONAL
  ENTERPRISE

  @@map("subscription_tier")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED

  @@map("subscription_status")
}

/// Modalità con cui un FIR viene agganciato/trasmesso al formulario RENTRI
/// corrispondente. AUTOMATICA: il gestionale trasmette e aggancia senza
/// intervento umano. IBRIDA: il gestionale trasmette automaticamente ma
/// l'aggancio (numero_fir ↔ FIR interno) va confermato da un operatore.
/// MANUALE: nessuna trasmissione automatica, l'operatore agisce su RENTRI
/// e riporta l'aggancio a mano. Default del tenant: vedi Tenant.rentriModalitaLegame.
enum RentriModalitaLegame {
  AUTOMATICA
  IBRIDA
  MANUALE

  @@map("rentri_modalita_legame")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keycloakId String @unique @map("keycloak_id") @db.VarChar(255)

  fiscalCode String  @map("fiscal_code") @db.VarChar(16)
  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  email      String  @db.VarChar(255)
  phone      String? @db.VarChar(20)

  role UserRole @default(OPERATOR)

  // Quota aziende creabili in autonomia da questo admin (decisa dal super admin).
  companyLimit Int @default(1) @map("company_limit")

  notificationPreferences Json? @map("notification_preferences")

  signatureCertificate     String?   @map("signature_certificate") @db.Text
  signatureCertificateHash String?   @map("signature_certificate_hash") @db.VarChar(64)
  signatureValidUntil      DateTime? @map("signature_valid_until")

  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producedFIRs            FIR[]               @relation("ProducerUser")
  carrierFIRs             FIR[]               @relation("CarrierUser")
  receiverFIRs            FIR[]               @relation("ReceiverUser")
  firSignatures           FIRSignature[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  createdBackupSchedules  BackupSchedule[]    @relation("CreatedByUser")
  executedBackupHistories BackupHistory[]     @relation("ExecutedByUser")
  recordedMovements       WasteMovement[]     @relation("RecordedMovements")
  allegatiRentriCaricati  FIRAllegatoRentri[]

  @@unique([tenantId, fiscalCode])
  @@index([tenantId])
  @@index([keycloakId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER

  @@map("user_role")
}

// ============================================================================
// ACCESS REQUEST (lead capture — richiesta di accesso / prova guidata)
// ============================================================================

/// Richiesta di accesso inviata dal form pubblico (/richiedi-accesso).
/// NON crea alcun tenant/utente: è un lead che il commerciale/consulente lavora
/// manualmente (attivazione white-glove del TRIAL via admin). Non tenant-scoped.
model AccessRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ragioneSociale String  @map("ragione_sociale") @db.VarChar(255)
  partitaIva     String? @map("partita_iva") @db.VarChar(11)
  firstName      String  @map("first_name") @db.VarChar(100)
  lastName       String  @map("last_name") @db.VarChar(100)
  email          String  @db.VarChar(255)
  phone          String? @db.VarChar(30)
  message        String? @db.Text

  status      AccessRequestStatus @default(PENDING)
  /// Nota interna del consulente (esito contatto, follow-up).
  handledNote String?             @map("handled_note") @db.Text

  @@index([status])
  @@index([createdAt])
  @@map("access_requests")
}

enum AccessRequestStatus {
  PENDING
  CONTACTED
  CONVERTED
  REJECTED

  @@map("access_request_status")
}

// ============================================================================
// FIR (Formulario Identificazione Rifiuti) - Core Domain
// ============================================================================

model FIR {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Assegnato all'emissione (BOZZA → EMESSO): nullable finché il FIR è bozza.
  firNumber String? @map("fir_number") @db.VarChar(50)

  status             FIRStatus @default(DRAFT)
  workflowVersion    Int       @default(1) @map("workflow_version")
  // Lock ottimistico (piano D4-D5): il repository la incrementa a ogni scrittura e rifiuta il
  // salvataggio di chi ha letto una versione diversa.
  versione           Int       @default(1) @map("versione")

  // F2-10 D9.4: sede scelta per produttore e destinatario (il trasportatore non ha sede sul FIR) e
  // codice fiscale delle tre parti. Senza FK (snapshot: la sede puo' cambiare o disattivarsi);
  // NULL per i FIR creati prima della migration 20261031110200.
  producerSedeId        String? @map("producer_sede_id") @db.Uuid
  receiverSedeId        String? @map("receiver_sede_id") @db.Uuid
  producerCodiceFiscale String? @map("producer_codice_fiscale") @db.VarChar(16)
  carrierCodiceFiscale  String? @map("carrier_codice_fiscale") @db.VarChar(16)
  receiverCodiceFiscale String? @map("receiver_codice_fiscale") @db.VarChar(16)
  submittedAt        DateTime? @map("submitted_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text

  // producerUserId = utente (operatore) che ha creato il FIR (FK obbligatoria a
  // User). producerId = riferimento al registro Produttore da cui è stato preso
  // lo "snapshot" anagrafico immutabile (campi *Name/*PartitaIva/*Address). Il
  // FIR è un documento legale: conserva lo snapshot, non un join live.
  producerUserId     String  @map("producer_user_id") @db.Uuid
  producerId         String? @map("producer_id") @db.Uuid
  producerPartitaIva String  @map("producer_partita_iva") @db.VarChar(11)
  producerName       String  @map("producer_name") @db.VarChar(255)
  producerAddress    String  @map("producer_address") @db.VarChar(500)
  producerContact    String? @map("producer_contact") @db.VarChar(255)

  carrierUserId       String? @map("carrier_user_id") @db.Uuid
  carrierId           String? @map("carrier_id") @db.Uuid
  carrierPartitaIva   String  @map("carrier_partita_iva") @db.VarChar(11)
  carrierName         String  @map("carrier_name") @db.VarChar(255)
  carrierVehiclePlate String  @map("carrier_vehicle_plate") @db.VarChar(20)
  carrierContact      String? @map("carrier_contact") @db.VarChar(255)

  receiverUserId     String? @map("receiver_user_id") @db.Uuid
  receiverId         String? @map("receiver_id") @db.Uuid
  receiverPartitaIva String  @map("receiver_partita_iva") @db.VarChar(11)
  receiverName       String  @map("receiver_name") @db.VarChar(255)
  receiverAddress    String  @map("receiver_address") @db.VarChar(500)
  receiverContact    String? @map("receiver_contact") @db.VarChar(255)

  // Formato canonico del catalogo "NN NN NN"(*) → fino a 9 char (VarChar(10)).
  cerCode          String  @map("cer_code") @db.VarChar(10)
  wasteDescription String  @map("waste_description") @db.VarChar(500)
  wasteCategory    String  @map("waste_category") @db.VarChar(100)
  quantity         Decimal @db.Decimal(10, 2)
  unit             String  @default("KG") @db.VarChar(10)

  // Tipo di operazione sul rifiuto presso il destinatario: recupero (R) o
  // smaltimento (D). Necessario per l'aggregazione MUD (recyclingRate) e per
  // il rendering del FIR. Default DISPOSAL (conservativo) finche' il dominio
  // non cattura il valore in fase di creazione FIR.
  wasteOperationType WasteOperationType @default(DISPOSAL) @map("waste_operation_type")

  // ---- Campi obbligatori FIR (DM 59/2023, art. 193 D.Lgs 152/2006) ----
  // Campo 2: stato fisico del rifiuto (Solido/Liquido/Fangoso/Polvere — Gassoso
  // e Misto rimossi 2026-09: nessun codice RENTRI corrispondente, v. StatoFisicoRifiuto)
  wastePhysicalState   String?   @map("waste_physical_state") @db.VarChar(50)
  // Campo 2: caratteristiche di pericolo HP (Reg. UE 1357/2014, All. III D.Lgs 152/2006)
  // Multi-valore, memorizzato come lista separata da virgole es. "HP4,HP14"
  wasteHazardClasses   String?   @map("waste_hazard_classes") @db.Text
  // Campo 2: numero colli dichiarato dal produttore
  wastePackageCount    Int?      @map("waste_package_count")
  // Campo 3: codice operazione R/D specifico (es. "R1", "D13") - All. B e C D.Lgs 152/2006
  wasteOperationCode   String?   @map("waste_operation_code") @db.VarChar(10)
  // Campo 17: annotazioni libere (obbligatorie per alcune tipologie di rifiuto)
  wasteNotes           String?   @map("waste_notes") @db.Text
  // Peso effettivo rilevato dal destinatario alla consegna (4ª copia FIR)
  effectiveWeight      Decimal?  @map("effective_weight") @db.Decimal(10, 2)
  // 4ª copia: data restituzione da destinatario a produttore
  fourthCopyReturnedAt DateTime? @map("fourth_copy_returned_at")
  // 4ª copia: note/esito del destinatario alla ricezione
  fourthCopyNotes      String?   @map("fourth_copy_notes") @db.Text
  /// Motivo dell'annullamento del FIR — locale (FIR.annulla) o RENTRI
  /// (note-annullamento, stesso testo trasmesso all'ente). Nullable: un FIR
  /// mai annullato non ce l'ha. Vincolo di lunghezza allineato al contratto
  /// RENTRI (NoteAnnullamentoModel.note, maxLength 1024) perché lo stesso testo
  /// viene anche inviato all'ente per un FIR legato.
  motivoAnnullamento   String?   @map("motivo_annullamento") @db.VarChar(1024)

  /// Provenienza del rifiuto (D.Lgs 152/2006): URBANO o SPECIALE. Richiesta dal
  /// contratto RENTRI (enum `ProvenienzaRifiuto`, codici 'U'/'S') per poter
  /// trasmettere un formulario: la traduzione ai codici ente resta compito del
  /// mappatore RENTRI, non di questo modello. Nullable: additiva, i FIR già in
  /// produzione (12 al 2026-09-10) non hanno questo dato e non viene inventato
  /// a posteriori — obbligatoria solo per i FIR creati da qui in avanti (DTO).
  provenienza ProvenienzaRifiuto? @map("provenienza")

  /// Modalità di trasporto della tratta principale (Campo 4, trasportatore
  /// inline su questo modello): riusa lo stesso enum `TipoTratta` già in uso
  /// per le tratte aggiuntive (`FIRTransporter.tipoTratta`), richiesto dal
  /// contratto RENTRI. Nullable per lo stesso motivo di `provenienza` sopra.
  tipoTrattaPrincipale TipoTratta? @map("tipo_tratta_principale")

  transportDate        DateTime  @map("transport_date")
  estimatedArrivalDate DateTime? @map("estimated_arrival_date")
  actualArrivalDate    DateTime? @map("actual_arrival_date")
  transportNotes       String?   @map("transport_notes") @db.Text

  rentriSyncStatus        RENTRISyncStatus @default(PENDING) @map("rentri_sync_status")
  // DEPRECATO: nonostante il nome, in pratica avrebbe dovuto contenere il
  // transazione_id della trasmissione (identificativo tecnico della singola
  // chiamata REST), non il numero ufficiale del formulario. Nessun punto del
  // codice lo valorizza oggi. Non rimosso (nessuna DROP su colonna già in
  // produzione): sostituito da rentriNumeroFir/rentriTransazioneId qui sotto,
  // che separano correttamente le due cose. Da rimuovere in una migrazione
  // futura dedicata, dopo aver verificato che sia effettivamente vuoto ovunque.
  rentriProtocolNumber    String?          @map("rentri_protocol_number") @db.VarChar(100)
  rentriSyncedAt          DateTime?        @map("rentri_synced_at")
  rentriSyncAttempts      Int              @default(0) @map("rentri_sync_attempts")
  rentriLastSyncError     String?          @map("rentri_last_sync_error") @db.Text
  // Codice macchina dell'ultimo fallimento (RENTRI_FORBIDDEN/RENTRI_RATE_LIMITED/
  // RENTRI_VALIDATION_ERROR/RENTRI_MISSING_NUMERO_FIR/RENTRI_API_ERROR — v.
  // SyncFIRToRENTRIUseCase). Distinto da rentriLastSyncError (testo libero):
  // senza un codice stabile l'interfaccia non può decidere in modo affidabile
  // se offrire «Riprova» (R1 Task 5, rentri-error-presentation.ts).
  rentriLastSyncErrorCode String?          @map("rentri_last_sync_error_code") @db.VarChar(100)
  rentriNextRetryAt       DateTime?        @map("rentri_next_retry_at")

  // Numero ufficiale assegnato da RENTRI al formulario (numero_fir dell'ente):
  // è la chiave stabile del legame FIR interno ↔ formulario RENTRI, non cambia
  // tra una trasmissione e l'altra. Nullable: valorizzato solo dopo l'aggancio.
  rentriNumeroFir         String?                @map("rentri_numero_fir") @db.VarChar(50)
  // Identificativo tecnico (transazione_id) restituito dall'ultima chiamata di
  // trasmissione REST verso RENTRI. Cambia ad ogni tentativo: non è una chiave
  // di aggancio, serve solo per correlare la trasmissione con il suo esito
  // (polling GET /{transazione_id}/status) e per il supporto.
  rentriTransazioneId     String?                @map("rentri_transazione_id") @db.VarChar(100)
  // Transazione di creazione accettata dall'ente e non ancora letta fino all'esito:
  // salvata subito, così un tentativo successivo la riprende invece di creare un doppione.
  rentriTransazioneInAttesa String?              @map("rentri_transazione_in_attesa") @db.VarChar(100)
  // Quando un processo ha prenotato la trasmissione (SYNCING): oltre la soglia di stallo
  // la prenotazione è riprendibile e il job di recupero la elenca.
  rentriSyncAvviatoAt     DateTime?              @map("rentri_sync_avviato_at") @db.Timestamptz(3)
  // Come è nato il legame con rentriNumeroFir: rilevante per cosa l'utente può
  // fare dopo (es. un legame acquisito da terzi non è ritrasmissibile) e in
  // caso di contestazione su chi ha originato/confermato l'aggancio.
  rentriOrigineLegame     RentriOrigineLegame?   @map("rentri_origine_legame")
  // Numero ufficiale ricevuto da una trasmissione automatica in modalità
  // IBRIDA (Tenant.rentriModalitaLegame) ma NON ancora confermato dall'utente:
  // finché è valorizzato, rentriNumeroFir resta null — il FIR non è "legato"
  // a tutti gli effetti (R1 Task 2, FIR.proporreLegameRENTRI/confermaLegameRENTRI).
  rentriNumeroFirProposto String?                @map("rentri_numero_fir_proposto") @db.VarChar(50)
  // Ultimo stato noto del formulario presso l'ente (StatoFormulario del
  // contratto RENTRI). Copia locale in SOLA LETTURA: si aggiorna SOLO
  // leggendo dall'ente (polling/webhook, mai da un'azione locale isolata —
  // v. FIR.applyRentriStato, R3 Task 1). Nullable: un FIR non legato non ce
  // l'ha, e anche un FIR appena legato può non avere ancora ricevuto alcuna
  // lettura.
  rentriStatoFormulario   RentriStatoFormulario? @map("rentri_stato_formulario")
  // Ultima volta che la riconciliazione periodica (R5 Task 4,
  // RiconciliaStatoRentriUseCase) ha effettivamente interrogato l'ente per
  // QUESTO FIR. Nullable: mai controllato. Serve a campionare, ad ogni
  // esecuzione, i FIR SYNCED meno recentemente verificati (ORDER BY questo
  // campo, NULL prima) invece dei primi N per data di sync o di creazione:
  // senza, un tenant con centinaia di FIR sincronizzati vedrebbe SEMPRE
  // controllati gli stessi (es. i più vecchi per rentriSyncedAt) e mai gli
  // altri, il che vanificherebbe il giro di "controllo di igiene" completo
  // in ~6,25 giorni descritto nel piano (20 campioni/6h, 500 FIR/tenant).
  // Aggiornato ad OGNI controllo (con o senza divergenza trovata), mai da
  // un'altra operazione: un campo dedicato, distinto da updatedAt (che
  // cambia per qualunque modifica al FIR, non solo per la riconciliazione).
  rentriLastReconciledAt  DateTime?              @map("rentri_last_reconciled_at")

  /// Byte del QR Code restituiti dall'ente alla vidimazione
  /// (`EfirModel.qr_code_bytes`/`EfirPublicModel.qr_code_bytes`, servizio
  /// `vidimazione-formulari`), Base64 COSI' COME li restituisce RENTRI —
  /// nessuna ricodifica qui, quella (Base64 -> Base45 -> disegno QR livello
  /// H) avviene a valle in `infrastructure/rentri/qr/` al momento di
  /// stampare il PDF. Prova della vidimazione: va conservata come si
  /// conserva `rentriNumeroFir`, non ricostruita. Nullable: un FIR non
  /// (ancora) vidimato dall'ente non ce l'ha — `pdf.controller.ts` decide
  /// di conseguenza se stampare il QR ufficiale o nessun QR (mai il vecchio
  /// QR con URL di verifica su un documento che sembrerebbe vidimato senza
  /// esserlo, v. `docs/audits/rentri-vidimazione-e-qr-2026-09-10.md`).
  rentriQrCodeBytes String? @map("rentri_qr_code_bytes") @db.Text

  /// SUPERATO da `FIRAllegatoRentri` (sotto), R3 Task 6 — non "il campo già
  /// in uso": verificato il 2026-07-27 che ha ZERO riferimenti in tutto il
  /// codice (backend, frontend, spec) e ZERO righe valorizzate in
  /// produzione. Non tipizzava il singolo allegato e non permetteva di
  /// elencarli o cancellarli singolarmente — da qui `FIRAllegatoRentri`,
  /// una riga per allegato con id RENTRI, dimensione e soggetto. NON
  /// rimosso (nessuna DROP su colonna già in produzione, anche se vuota):
  /// se un domani serve un allegato "solo nostro" non legato a RENTRI,
  /// riusare questo campo con un modello tipizzato dedicato — mai un terzo
  /// `Json?` parallelo a rappresentare la stessa cosa.
  attachmentUrls Json? @map("attachment_urls")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producerUser   User                @relation("ProducerUser", fields: [producerUserId], references: [id])
  carrierUser    User?               @relation("CarrierUser", fields: [carrierUserId], references: [id])
  receiverUser   User?               @relation("ReceiverUser", fields: [receiverUserId], references: [id])
  signatures     FIRSignature[]
  activityLogs   ActivityLog[]
  rentriSyncLogs RENTRISyncLog[]
  allegatiRentri FIRAllegatoRentri[]

  // Trasportatori aggiuntivi per trasporto intermodale (oltre al trasportatore
  // principale inline Campo 4): N tratte ordinate (terrestre/ferroviaria/
  // marittima), ognuna con proprio snapshot anagrafico immutabile.
  transportersAggiuntivi FIRTransporter[]

  // Pese (Fase 4 pezzo 8a): accessi collegati a questo FIR.
  collegamentiAccesso CollegamentoAccesso[]

  // Bersaglio della chiave esterna composta delle figlie (firma, trasportatore,
  // allegato): obbliga il loro tenant_id a coincidere con quello del FIR.
  @@unique([id, tenantId])
  @@unique([tenantId, firNumber])
  // Vincolo di unicità (non solo indice, v. R2 Task 3): due FIR locali dello
  // stesso tenant non possono puntare allo stesso numero_fir RENTRI — un
  // formulario dell'ente non può risultare agganciato due volte. In
  // PostgreSQL un indice unique tratta i NULL come distinti fra loro, quindi
  // i FIR non ancora legati (rentriNumeroFir = null) non collidono mai fra
  // loro: il vincolo blocca solo il caso reale da evitare (due righe con lo
  // STESSO numero_fir non nullo). Verificato (2026-07-26, DB di test vuoto,
  // nessun dato reale disponibile in questo ambiente) che non esistono già
  // duplicati: query di controllo e verdetto nel report del task.
  @@unique([tenantId, rentriNumeroFir])
  @@index([tenantId])
  @@index([status])
  @@index([rentriSyncStatus])
  @@index([rentriSyncStatus, rentriSyncAvviatoAt])
  @@index([transportDate])
  @@index([cerCode])
  @@index([tenantId, wasteOperationType])
  // Supporta la query di campionamento del Task 4 (R5): per tenant, solo i
  // FIR SYNCED, ordinati per "meno recentemente verificato" (NULL prima).
  @@index([tenantId, rentriSyncStatus, rentriLastReconciledAt])
  @@map("firs")
}

enum FIRStatus {
  DRAFT
  AWAITING_PRODUCER
  AWAITING_CARRIER
  AWAITING_RECEIVER
  COMPLETED
  SYNCED_TO_RENTRI
  CANCELLED

  @@map("fir_status")
}

enum RENTRISyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  PERMANENTLY_FAILED

  @@map("rentri_sync_status")
}

/// Origine del legame tra il FIR interno e il numero_fir RENTRI
/// (FIR.rentriNumeroFir). Distingue i tre modi in cui l'aggancio può nascere:
/// - TRASMESSO_DA_NOI: il formulario è stato creato da una nostra trasmissione
///   (POST di creazione formulario) ed è quindi "nostro" a tutti gli effetti.
/// - ACQUISITO_DA_TERZI: il formulario esiste già su RENTRI (creato da un'altra
///   controparte, es. il produttore) e il legame nasce da un'acquisizione di
///   visibilità (POST /{numero_fir}/acquisizione-visibilita/{num_iscr_sito}) —
///   non l'abbiamo creato noi, quindi non è ritrasmissibile/modificabile come
///   se fosse nostro.
/// - AGGANCIO_MANUALE: un operatore ha associato a mano il FIR interno a un
///   numero_fir esistente (es. dopo una modalità MANUALE), senza passare né da
///   una nostra trasmissione né da un'acquisizione di visibilità automatica.
enum RentriOrigineLegame {
  TRASMESSO_DA_NOI
  ACQUISITO_DA_TERZI
  AGGANCIO_MANUALE

  @@map("rentri_origine_legame")
}

/// Stato del formulario secondo l'ente RENTRI (contratto OpenAPI,
/// docs/contracts/rentri/formulari.yaml, schema StatoFormulario). 21 valori
/// ESATTI copiati dal contratto — non tradotti (sono già in italiano nel
/// contratto stesso), non un sottoinsieme. Rispecchia FIR.rentriStatoFormulario
/// (TypeScript, v. fir.aggregate.ts, StatoFormulario) — le due liste devono
/// restare identiche a ogni evoluzione del contratto.
///
/// Distinto da FIRStatus/FIRStato (il ciclo di vita interno WasteFlow):
/// finché un FIR non è legato a RENTRI comanda il ciclo interno come oggi;
/// da quando è legato questo stato ente "vince" e viene rispecchiato tramite
/// FIR.applyRentriStato (R3 Task 1).
enum RentriStatoFormulario {
  InserimentoQuantita
  InserimentoQuantitaTrasportoIniziale
  InserimentoTrasportoIniziale
  FirmaProduttoreTrasportatoreIniziale
  FirmaTrasportatoreIniziale
  FirmaProduttore
  InserimentoTrasportoSuccessivo
  FirmaTrasportatoreSuccessivo
  FirmaAnnotazione
  FirmaTrasbordoParziale
  FirmaTrasbordoTotale
  FirmaSostaTecnica
  FirmaAllegato
  InserimentoAccettazione
  FirmaAccettazione
  Accettato
  RespintoAccettatoParzialmente
  FirmaDestinatarioSuccessivo
  FirmaAccettazioneSuccessiva
  FirmaAnnullamento
  Annullato
  Indeterminato

  @@map("rentri_stato_formulario")
}

/// Tipo di operazione di destinazione del rifiuto (D.Lgs 152/2006):
/// RECOVERY = operazioni R (recupero), DISPOSAL = operazioni D (smaltimento).
enum WasteOperationType {
  RECOVERY
  DISPOSAL

  @@map("waste_operation_type")
}

model FIRSignature {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firId     String   @map("fir_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role            String   @db.VarChar(50)
  signedAt        DateTime @map("signed_at")
  signatureMethod String   @default("ECDSA-SHA256") @map("signature_method") @db.VarChar(50)

  signatureValue  String @map("signature_value") @db.Text
  certificateHash String @map("certificate_hash") @db.VarChar(64)
  documentHash    String @map("document_hash") @db.VarChar(64)

  timestampToken String? @map("timestamp_token") @db.Text

  /// Codice fiscale del firmatario (snapshot auto-descrittivo — invariante legale).
  /// Nullable per retrocompatibilità con firme pre-migrazione.
  /// ATTIVARE: popolato automaticamente da POST /fir/:id/sign (WS-E).
  signerFiscalCode String? @map("signer_fiscal_code") @db.VarChar(16)
  /// Nome e cognome del firmatario (snapshot auto-descrittivo).
  signerName       String? @map("signer_name") @db.VarChar(255)
  /// Chiave pubblica PEM per verifica crittografica offline.
  /// Nullable per retrocompatibilità. ATTIVARE: popolato da POST /fir/:id/sign.
  publicKey        String? @map("public_key") @db.Text

  fir  FIR  @relation(fields: [firId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([firId])
  @@index([userId])
  @@index([signerFiscalCode])
  @@map("fir_signatures")
}

/// Provenienza del rifiuto (D.Lgs 152/2006): urbano o speciale. Valori leggibili
/// di dominio — il contratto RENTRI usa i codici 'U'/'S' (`ProvenienzaRifiuto`
/// del contratto), tradotti dal mappatore RENTRI, non da questo enum.
enum ProvenienzaRifiuto {
  URBANO
  SPECIALE

  @@map("provenienza_rifiuto")
}

/// Tipo di tratta di un trasporto intermodale (D.Lgs 152/2006, FIR multimodale):
/// trasporto su gomma (TERRESTRE), su rotaia (FERROVIARIA) o via mare (MARITTIMA).
enum TipoTratta {
  TERRESTRE
  FERROVIARIA
  MARITTIMA

  @@map("tipo_tratta")
}

/// Trasportatore aggiuntivo di una tratta intermodale del FIR. Il trasportatore
/// principale resta inline su FIR (Campo 4); qui si modellano le N tratte
/// successive, ordinate, ognuna con lo snapshot anagrafico immutabile preso dal
/// registro Trasportatore al momento della creazione del FIR.
model FIRTransporter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firId     String   @map("fir_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  ordine     Int        @db.Integer
  tipoTratta TipoTratta @map("tipo_tratta")

  // Riferimento al registro Trasportatore di provenienza dello snapshot (può
  // essere null per trasportatori non presenti nel registro).
  trasportatoreId String? @map("trasportatore_id") @db.Uuid

  // Snapshot anagrafico immutabile (congelato alla creazione del FIR).
  denominazione        String  @map("denominazione") @db.VarChar(255)
  partitaIva           String? @map("partita_iva") @db.VarChar(11)
  codiceFiscale        String? @map("codice_fiscale") @db.VarChar(16)
  numeroIscrizioneAlbo String? @map("numero_iscrizione_albo") @db.VarChar(50)

  // Mezzo/identificativo: targa (terrestre), numero treno o nome nave.
  mezzo             String?   @map("mezzo") @db.VarChar(100)
  dataPresaInCarico DateTime? @map("data_presa_in_carico")

  fir FIR @relation(fields: [firId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([firId])
  @@map("fir_transporters")
}

model MUDReport {
