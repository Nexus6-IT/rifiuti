  RENTRI_SYNC_FAILED
  RENTRI_SYNC_SUCCESS
  MUD_DEADLINE_APPROACHING
  SUBSCRIPTION_EXPIRING
  SIGNATURE_REQUIRED
  SYSTEM_ERROR

  @@map("notification_type")
}

