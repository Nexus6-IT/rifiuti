{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/campo/index.html",
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "!/sw-campo.js"]
      }
    },
    {
      "name": "icone",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/icone/**"]
      }
    }
  ]
}
