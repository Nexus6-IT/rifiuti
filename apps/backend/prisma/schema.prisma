/// Movimento del registro cronologico di carico/scarico rifiuti
/// (art. 190 D.Lgs 152/2006, DM 59/2023). I CARICO incrementano la giacenza in
/// deposito temporaneo, gli SCARICO la decrementano (tipicamente collegati a
/// un FIR). Base per il calcolo giacenze, monitoraggio deposito temporaneo e
/// export del registro. Vidimazione digitale tramite hash SHA-256 dei campi
/// chiave (entryHash), obbligatoria dal 13/02/2025 per soggetti RENTRI.
model WasteMovement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Numero progressivo dell'annotazione per tenant/anno (art. 190 D.Lgs 152/2006).
  /// Assegnato automaticamente in sequenza — mai modificabile post-registrazione.
  progressiveNumber Int @map("progressive_number")
  /// Anno solare del progressivo (per il reset annuale).
  progressiveYear   Int @map("progressive_year")

  type WasteMovementType

  /// Data effettiva dell'operazione di carico/scarico.
  movementDate     DateTime @map("movement_date")
  /// Data di annotazione nel registro. Per legge: entro 10 gg lavorativi per
  /// produttori (art. 190 c. 1 lett. a); entro 2 gg lavorativi per gestori
  /// impianti di recupero/smaltimento (art. 190 c. 1 lett. d).
  registrationDate DateTime @default(now()) @map("registration_date")

  /// Causale specifica del movimento: codice di una causale del catalogo (`causali_registro`)
  /// o dell'azienda (`AZ_…`, con `causaleAziendaId`).
  causale String @db.VarChar(100)

  /// Codice CER (formato canonico "NN NN NN" o "NN NN NN*" per pericolosi, max 10 char).
  cerCode          String  @map("cer_code") @db.VarChar(10)
  wasteDescription String? @map("waste_description") @db.VarChar(500)
  quantity         Decimal @db.Decimal(10, 2)
  unit             String  @default("KG") @db.VarChar(10)

  /// Stato fisico del rifiuto (Solido/Liquido/Fangoso/Gassoso/Polvere/Misto).
  wastePhysicalState String? @map("waste_physical_state") @db.VarChar(50)
  /// Caratteristiche di pericolo HP (es. "HP4,HP14") — obbligatorio per rifiuti pericolosi.
  wasteHazardClasses String? @map("waste_hazard_classes") @db.VarChar(100)
  /// Codice operazione di destinazione R/D (es. "R1", "D13") — All. B/C D.Lgs 152/2006.
  operationCode      String? @map("operation_code") @db.VarChar(10)

  /// Denominazione della controparte (cedente/produttore per CARICO; destinatario per SCARICO).
  counterpartName    String? @map("counterpart_name") @db.VarChar(255)
  /// Indirizzo impianto/sede della controparte.
  counterpartAddress String? @map("counterpart_address") @db.VarChar(500)

  /// SCARICO: FIR collegato (uscita verso trasportatore/destinatario).
  firId         String? @map("fir_id") @db.Uuid
  /// Copia di firId valorizzata solo dai movimenti registrati dopo l'indice unico
  /// della ricopia (i movimenti storici restano NULL, e i NULL non collidono):
  /// un FIR si ricopia nel registro una sola volta per tipo di movimento e chiave.
  firIdRicopia  String? @map("fir_id_ricopia") @db.Uuid
  /// Chiave che distingue più movimenti dello stesso FIR e tipo (C-W-03, come WinWaste):
  /// '' per la ricopia ordinaria, l'unica usata oggi. Lo schema delle chiavi riservate è
  /// in RICOPIA_ORDINARIA (registra-movimento.use-case.ts); la chiave la impone il flusso.
  ricopiaChiave String  @default("") @map("ricopia_chiave") @db.VarChar(100)

  /// Utente (operatore) che ha registrato l'annotazione.
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid

  /// Hash SHA-256 dei campi chiave dell'annotazione (vidimazione digitale, DM 59/2023).
  /// Formato: SHA-256 hex di "{tenantId}|{progressiveYear}|{progressiveNumber}|{type}|{cerCode}|{quantity}|{movementDate}|{causale}"
  entryHash String @default("") @map("entry_hash") @db.VarChar(64)

  notes String? @db.Text

  /// Registro (per sede) in cui il movimento e' annotato (Fase 2 pezzo 1): numerazione e
  /// giacenza sono per registro.
  registroId String @map("registro_id") @db.Uuid

  /// Fase 2 pezzo 3: rettifica e annullamento sono NUOVE annotazioni (mai UPDATE/DELETE di una riga):
  /// ORDINARIA = registrazione normale, RETTIFICA = sostituisce la precedente, ANNULLAMENTO = toglie
  /// dai conteggi l'intera catena. Vigente = non ANNULLAMENTO e nessuna riga la indica come predecessore.
  tipoAnnotazione        TipoAnnotazioneMovimento @default(ORDINARIA) @map("tipo_annotazione")
  /// Predecessore diretto (l'annotazione che questa corregge); NULL per le ORDINARIA.
  movimentoRettificatoId String?                  @map("movimento_rettificato_id") @db.Uuid
  /// Radice della catena (la ORDINARIA di partenza); coincide col predecessore alla prima correzione.
  movimentoOriginaleId   String?                  @map("movimento_originale_id") @db.Uuid
  /// Motivo della correzione (1..500 dopo trim); NULL per le ORDINARIA.
  motivoAnnotazione      String?                  @map("motivo_annotazione") @db.VarChar(500)
  /// Versione dell'hash dell'annotazione (1 = storico, 2 = concatenato per registro e anno).
  hashVersione           Int                      @default(1) @map("hash_versione") @db.SmallInt
  /// Fase 2 pezzo 5: versione della causale aziendale scelta (NULL per le causali di sistema e per le
  /// storiche). Non entra nell'hash. Il CHECK `waste_movements_causale_azienda_coerente` lega
  /// `causale LIKE 'AZ_%'` alla presenza del riferimento; la FK composta fa coincidere codice e verso.
  causaleAziendaId       String?                  @map("causale_azienda_id") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedByUser User?           @relation("RecordedMovements", fields: [recordedByUserId], references: [id])
  registro       RegistroRifiuti @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Predecessore: stesso registro, azienda e tipo (chiave composta verso l'unico sotto). NoAction:
  /// il controllo e' a fine statement, cosi' una catena intera si cancella in un solo DELETE.
  rettificato WasteMovement?  @relation("Correzioni", fields: [movimentoRettificatoId, registroId, tenantId, type], references: [id, registroId, tenantId, type], onDelete: NoAction, onUpdate: NoAction, map: "waste_movements_rettificato_fkey")
  correzioni  WasteMovement[] @relation("Correzioni")
  /// Radice della catena, con gli stessi vincoli di registro, azienda e tipo.
  originale   WasteMovement?  @relation("Radice", fields: [movimentoOriginaleId, registroId, tenantId, type], references: [id, registroId, tenantId, type], onDelete: NoAction, onUpdate: NoAction, map: "waste_movements_originale_fkey")
  catena      WasteMovement[] @relation("Radice")
  /// Versione della causale aziendale usata. NoAction: la cancellazione a cascata di un'azienda
  /// toglie movimenti e causali nello stesso statement.
  causaleAzienda CausaleRegistroAzienda? @relation("MovimentiCausale", fields: [causaleAziendaId, tenantId, causale, type], references: [id, tenantId, codice, verso], onDelete: NoAction, onUpdate: NoAction, map: "waste_movements_causale_azienda_fkey")

  collegamentiAccesso CollegamentoAccesso[]

  @@unique([id, registroId, tenantId, type], map: "waste_movements_id_registro_tenant_type_key")
  @@unique([movimentoRettificatoId], map: "waste_movements_movimento_rettificato_id_key")
  @@index([movimentoOriginaleId], map: "waste_movements_movimento_originale_id_idx")
  @@index([causaleAziendaId], map: "waste_movements_causale_azienda_id_idx")
  @@unique([registroId, progressiveYear, progressiveNumber])
  @@index([registroId, cerCode])
  @@unique([tenantId, firIdRicopia, type, ricopiaChiave])
  @@index([tenantId, cerCode])
  @@index([tenantId, movementDate])
  @@index([tenantId, type])
  @@index([firId])
  @@map("waste_movements")
}

enum WasteMovementType {
  CARICO
  SCARICO

  @@map("waste_movement_type")
}

enum TipoAnnotazioneMovimento {
  ORDINARIA
  RETTIFICA
  ANNULLAMENTO

  @@map("tipo_annotazione_movimento")
}

/// Credenziale RENTRI per-tenant (Modello di Interoperabilità AgID).
/// Ogni operatore (tenant) ha il PROPRIO certificato di interoperabilità: le
/// chiamate API RENTRI vengono firmate per conto di quel tenant. La chiave
/// privata è cifrata a riposo (AES-256-GCM, vedi rentri-crypto.util.ts) — mai
/// in chiaro nel DB. Un solo set di credenziali per tenant.
model RentriCredential {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Identificativo operatore/client (iss/sub della client_assertion).
  clientId       String  @map("client_id") @db.VarChar(255)
  /// Certificato X.509 in PEM (per x5c). Non sensibile come la chiave.
  certificatePem String  @map("certificate_pem") @db.Text
  /// Chiave privata PEM CIFRATA (formato iv:tag:ciphertext base64).
  privateKeyEnc  String  @map("private_key_enc") @db.Text
  /// Algoritmo di firma JOSE: RS256 (cert RSA) | ES256 (cert EC).
  algorithm      String  @default("RS256") @db.VarChar(10)
  /// Ambiente RENTRI dichiarato per la credenziale: demo | live.
  environment    String  @default("demo") @db.VarChar(10)
  /// DEPRECATO (2026-07-26, R2 multi-sede): un'azienda con più unità locali
  /// operative su RENTRI non trova posto in un singolo valore per tenant.
  /// Il modello attuale è `RentriUnitaLocale` (figlia del tenant, con flag
  /// `principale`). Questo campo resta per compatibilità finché la
  /// migrazione del dato esistente (prima unità locale = principale) non è
  /// verificata in produzione — stessa cautela già adottata con
  /// `rentriProtocolNumber`. Non scrivere più qui: nuove sedi vanno create
  /// in `RentriUnitaLocale`. Formato storico (se presente):
  /// ^OP[0-9]{4}[A-Z0-9]{3}[0-9]{6}-[A-Z]{2}[0-9]{4}$ (formulari.yaml riga 684).
  numIscrSito    String? @map("num_iscr_sito") @db.VarChar(30)

  /// Numero di iscrizione dell'OPERATORE (non dell'unità locale), rilasciato
  /// da RENTRI all'iscrizione: parametro `num_iscr` di
  /// `GET /anagrafiche/v1.0/operatore/{num_iscr}/siti` (R4 Task 3). Nessun
  /// pattern impostato: `anagrafiche.yaml` lo dichiara `string` semplice,
  /// senza vincoli di formato (a differenza di `num_iscr_sito`, che
  /// `formulari.yaml` vincola con una regex — un vincolo specifico di quel
  /// contratto, non di questo campo).
  numIscrOperatore    String?   @map("num_iscr_operatore") @db.VarChar(30)
  /// Ultimo allineamento riuscito delle unità locali del tenant da
  /// `GET /operatore/{num_iscr}/siti` (R4 Task 3). Cache TTL: l'apertura
  /// della sezione «Unità locali» non richiama l'ente se questo timestamp è
  /// più recente di un'ora (v. `SincronizzaSitiUseCase`) — evita di
  /// contattare RENTRI a ogni apertura pagina per un dato che cambia solo per
  /// iniziativa dell'azienda (nuova sede, variazione), non per un ciclo
  /// dell'ente.
  sitiSincronizzatiAl DateTime? @map("siti_sincronizzati_al")

  /// Identificativo delle credenziali di firma remota RENTRI (`credentials_id`,
  /// API "ca-rentri" — R3 Task 3), create tramite il boarding umano
  /// (QR Code + PIN dall'area Operatori del portale, non automatizzabile).
  /// Nullable: un tenant può avere l'interoperabilità configurata senza aver
  /// ancora fatto il boarding della firma remota (il ciclo di accettazione/
  /// annullamento resta bloccato allo stato Firma* finché non lo fa).
  ///
  /// Sta QUI e non in una tabella figlia: `RentriCredential` è già "una riga
  /// di configurazione RENTRI per tenant", e il certificato di firma remota
  /// (sigillo M.O. 16) è riferito all'OPERATORE — stessa granularità e stesso
  /// ciclo di vita del resto della riga. La motivazione che rese necessaria
  /// `RentriUnitaLocale` ("un'azienda ha PIÙ sedi") non si applica qui.
  ///
  /// Nessun pattern: il formato di `credentials_id` non è documentato da
  /// alcuna fonte ufficiale — una regex inventata rifiuterebbe valori
  /// legittimi. Unico vincolo applicativo: non vuoto se valorizzato.
  credentialsIdFirmaRemota String? @map("credentials_id_firma_remota") @db.VarChar(255)

  @@map("rentri_credentials")
}

/// Unità locale RENTRI di un tenant (figlia del tenant, non del certificato:
/// un'azienda può avere più sedi operative iscritte a RENTRI, ciascuna col
/// proprio `numIscrSito`, mentre il certificato di interoperabilità
/// (RentriCredential) resta uno per tenant).
///
/// `principale`: chi ha una sola sede non deve scegliere nulla — il
/// comportamento resta quello di prima del multi-sede; chi ne ha più d'una
/// sceglie esplicitamente quale usare di default. Vincolo di esattamente una
/// principale per tenant enforced a livello applicativo + indice unico
/// parziale (vedi migrazione `WHERE principale = true`).
///
/// `attiva`: una sede può cessare l'attività senza che spariscano i
/// formulari già agganciati che la referenziano (mai cancellazione fisica
/// per una sede con storico).
///
/// Popolamento: in R2 è inserimento manuale dall'amministratore; il client
/// anagrafiche di R4 (`GET /operatore/{num_iscr}/siti`) potrà popolare questa
/// tabella automaticamente senza cambiarne la forma.
model RentriUnitaLocale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Numero di iscrizione dell'unità locale RENTRI (formato
  /// ^OP[0-9]{4}[A-Z0-9]{3}[0-9]{6}-[A-Z]{2}[0-9]{4}$, formulari.yaml riga 684).
  numIscrSito   String  @map("num_iscr_sito") @db.VarChar(30)
  /// Denominazione leggibile scelta dall'operatore (es. "Sede di Milano"),
  /// per farla scegliere senza dover riconoscere il codice numIscrSito.
  denominazione String  @db.VarChar(255)
  /// Sede di default per il tenant. Esattamente una per tenant (vedi indice
  /// unico parziale nella migrazione).
  principale    Boolean @default(false)
  /// Sede operativa. false quando la sede ha cessato l'attività: i formulari
  /// già agganciati alla sede restano validi, la sede esce solo dalle scelte
  /// per nuovi agganci.
  attiva        Boolean @default(true)

  /// Blocco virtuale (RENTRI) usato di default per vidimare i FIR emessi da
  /// questa unità locale (R6, scorta vidimazioni — v. `RentriNumeroVidimato`
  /// e `docs/audits/rentri-blocchi-come-fanno-gli-altri-2026-09-11.md`).
  /// Nessuna FK verso RENTRI (il blocco vive solo lato ente, letto via
  /// `RentriVidimazioneClient.elencaBlocchi`): qui è solo il codice scelto
  /// dall'utente quando c'è ambiguità fra più blocchi attivi sulla stessa
  /// sede. Null finché nessuno lo imposta esplicitamente — in quel caso il
  /// job di rifornimento non vidima nulla per questa sede (fail-closed, mai
  /// un blocco indovinato).
  codiceBloccoPredefinito String? @map("codice_blocco_predefinito") @db.VarChar(50)

  /// Quanti numeri vidimati tenere sempre pronti in scorta per questa sede
  /// (soglia di rifornimento, R6). Null = nessuna soglia configurata: il job
  /// periodico non rifornisce nulla per questa sede e lo scrive nel log,
  /// mai un valore di ripiego inventato.
  dimensioneScortaDesiderata Int? @map("dimensione_scorta_desiderata")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registri RegistroRifiuti[]

  @@unique([tenantId, numIscrSito])
  @@index([tenantId])
  @@map("rentri_unita_locali")
}

/// Registro cronologico di carico e scarico di una sede (Fase 2 pezzo 1, D1/D4): un registro per
/// unita' locale, con codice CARICO_SCARICO. `unitaLocaleId` nullo = registro "senza sede" (azienda
/// senza sede RENTRI), che si lega a una sede una sola volta (trigger registri_rifiuti_sede_immutabile,
/// non esprimibile in Prisma, come l'indice unico parziale registri_rifiuti_uno_senza_sede_per_tenant).
model RegistroRifiuti {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unitaLocaleId        String? @map("unita_locale_id") @db.Uuid
  codice               String  @default("CARICO_SCARICO") @db.VarChar(30)
  descrizione          String  @db.VarChar(255)
  /// Identificativo del registro assegnato dal RENTRI (non ancora valorizzato: F2-9).
  identificativoRentri String? @map("identificativo_rentri") @db.VarChar(100)
  attivo               Boolean @default(true)

  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitaLocale         RentriUnitaLocale?            @relation(fields: [unitaLocaleId], references: [id], onDelete: Restrict)
  movimenti           WasteMovement[]
  accessiPesa         AccessoPesa[]
  strumentiPesa       StrumentoPesa[]
  progressiviIniziali RegistroProgressivoIniziale[]
  giacenzeIniziali    GiacenzaIniziale[]
  soglieDeposito      SogliaDepositoTemporaneo[]

  @@unique([id, tenantId])
  @@unique([tenantId, unitaLocaleId, codice])
  @@index([tenantId])
  @@map("registri_rifiuti")
}

/// Stato di un numero FIR già vidimato dall'ente e tenuto in scorta (R6).
enum RentriNumeroVidimatoStato {
  /// Vidimato dall'ente, non ancora assegnato a nessun FIR: pronto all'uso.
  DISPONIBILE
  /// Consumato da un'emissione locale (`firId` valorizzato).
  USATO
  /// Annullato presso l'ente (`RentriVidimazioneClient.annullaFir`) prima di
  /// essere usato — resta per audit, mai cancellato.
  ANNULLATO
}

/// Scorta di numeri FIR pre-vidimati dall'ente RENTRI (R6 — "chi fa i FIR
/// cartacei con supporto interoperabilità vidima IN ANTICIPO, a lotti, e
/// consuma dalla scorta all'emissione": v.
/// `docs/audits/rentri-blocchi-come-fanno-gli-altri-2026-09-11.md`).
///
/// Popolata da `RentriRifornimentoScortaJob`/`AvviaVidimazioneScortaUseCase`
/// chiamando `RentriVidimazioneClient.vidimaFir` + `attendiEsitoVidimazione`
/// (esito = `EfirPublicModel`, incluso `qr_code_bytes` firmato dall'ente).
/// Consumata SOLO tramite `RentriScortaRepository.consumaProssimoDisponibile`
/// (UPDATE...WHERE id = (SELECT...FOR UPDATE SKIP LOCKED LIMIT 1) in un solo
/// statement: due emissioni concorrenti non possono mai ricevere lo stesso
/// numero, v. commento di classe del repository).
///
/// Isolamento: tenantId basta (= l'azienda, v. `Tenant`/`TENANT_SCOPED_MODELS`
/// — questo progetto non ha un concetto di "azienda" separato dal tenant).
model RentriNumeroVidimato {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Unità locale (num_iscr_sito) su cui è stato vidimato il numero.
  numIscrSito String @map("num_iscr_sito") @db.VarChar(30)
  /// Codice del blocco virtuale RENTRI su cui è stato vidimato.
  codiceBlocco String @map("codice_blocco") @db.VarChar(50)
  /// Progressivo del numero all'interno del blocco (`EfirPublicModel.progressivo`).
  progressivo Int
  /// Numero FIR assegnato dall'ente (`EfirPublicModel.numero_fir`).
  numeroFir String @map("numero_fir") @db.VarChar(100)
  /// Byte firmati dall'ente per il QR (Base64, `EfirPublicModel.qr_code_bytes`)
  /// — v. `docs/audits/rentri-vidimazione-e-qr-2026-09-10.md` §1: si
  /// decodificano da Base64 e si ricodificano in Base45 per il disegno del
  /// QR (`infrastructure/rentri/qr/`), nessun contenuto costruito da noi.
  qrCodeBytes String @map("qr_code_bytes") @db.Text

  stato RentriNumeroVidimatoStato @default(DISPONIBILE)

  /// FIR locale che ha consumato questo numero (valorizzato solo se stato = USATO).
  firId String? @map("fir_id") @db.Uuid

  dataVidimazione DateTime  @map("data_vidimazione")
  dataConsumo     DateTime? @map("data_consumo")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codiceBlocco, progressivo])
  @@index([tenantId, numIscrSito, stato])
  @@map("rentri_numeri_vidimati")
}

/// Log di sincronizzazione RENTRI: un record per ogni tentativo di
/// trasmissione di un FIR verso l'ente (audit trail immutabile, mai
/// aggiornato né cancellato — vedi RENTRISyncLogRepository.update/delete).
/// Nome del modello volutamente `RENTRISyncLog` (non `RentriSyncLog`): Prisma
/// genera l'accessor del client abbassando solo la prima lettera del nome
/// modello, quindi `RENTRISyncLog` → `prisma.rENTRISyncLog`, che è esattamente
/// ciò che rentri-sync-log.repository.ts si aspetta nelle chiamate commentate.
model RENTRISyncLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firId     String   @map("fir_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  status  RENTRISyncLogStatus
  attempt Int

  /// Origine del tentativo registrato da questa riga (R5 Task 4): TRASMISSIONE
  /// per il flusso normale (SyncFIRToRENTRIUseCase e affini, valore di
  /// default per non richiedere una migrazione dati sulle righe esistenti),
  /// RICONCILIAZIONE per un controllo periodico di allineamento
  /// (RiconciliaStatoRentriUseCase). Senza questo campo un audit/contestazione
  /// non potrebbe distinguere "abbiamo trasmesso questo FIR" da "abbiamo
  /// solo verificato che l'ente lo vedesse ancora allineato".
  origine RENTRISyncLogOrigine @default(TRASMISSIONE) @map("origine")

  /// Payload della richiesta inviata a RENTRI (JSON xFIR), per audit/debug.
  requestPayload  String  @map("request_payload") @db.Text
  responsePayload String? @map("response_payload") @db.Text

  errorMessage String? @map("error_message") @db.Text
  errorCode    String? @map("error_code") @db.VarChar(100)

  /// Numero/protocollo restituito dall'ente in caso di esito SUCCESS di
  /// *questo* tentativo (non necessariamente il numero_fir stabile: dipende
  /// da cosa l'API RENTRI restituisce per l'operazione tentata).
  protocolNumber String? @map("protocol_number") @db.VarChar(100)

  syncedAt   DateTime? @map("synced_at")
  durationMs Int?      @map("duration_ms")

  fir FIR @relation(fields: [firId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([firId])
  @@index([status])
  @@index([createdAt])
  @@map("rentri_sync_logs")
}

/// Allegato di un formulario RENTRI (`POST/GET/DELETE /{numero_fir}/allegato`,
/// R3 Task 6) — sostituisce l'uso previsto (ma mai realizzato: nessuna
/// occorrenza nel codice) del generico `FIR.attachmentUrls Json?`, che non
/// tipizzava il singolo allegato e non permetteva di elencarli o cancellarli
/// singolarmente. Una riga per allegato caricato con successo sull'ente:
/// creata SOLO dopo che `POST /allegato` ha restituito un esito senza
/// `errore` (mai un'aggiunta ottimistica prima della conferma dell'ente),
/// cancellata SOLO dopo che `DELETE /allegato/{allegato_id}` ha fatto lo
/// stesso (vedi GestisciAllegatiFIRUseCase — un fallimento a metà non lascia
/// mai RENTRI e la copia locale disallineati in silenzio: l'eccezione lo
/// dichiara esplicitamente).
model FIRAllegatoRentri {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firId     String   @map("fir_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  /// `allegato_id` restituito dall'ente (`EsitoAddAllegatoModel.allegato_id`,
  /// formulari.yaml riga 9163): chiave per `GET`/`DELETE
  /// /{numero_fir}/allegato/{allegato_id}`. Non è la chiave primaria locale
  /// (quella è `id`, UUID) perché è un intero assegnato dall'ente, non da noi.
  rentriAllegatoId Int @map("rentri_allegato_id")

  /// Nome del file (`DatiAllegatoModel.nome_file`, maxLength 255).
  filename  String @db.VarChar(255)
  /// Tipo MIME dichiarato all'ente (`content_type`). Il contratto ammette
  /// solo "application/pdf" oggi, ma il campo resta libero: è l'ente che
  /// decide cosa accettare, non un'assunzione fissata qui.
  mimeType  String @map("mime_type") @db.VarChar(255)
  /// Dimensione in byte del file ORIGINALE (non della codifica base64
  /// trasmessa): è il numero verificato localmente PRIMA della chiamata
  /// contro il limite di 1 MB dichiarato da `DatiAllegatoModel.contenuto`
  /// (formulari.yaml riga 6926 — proprio di questo endpoint, non il limite di
  /// 3 MB/5 MB di xFIR/copia cartacea, che sono vincoli di altri oggetti).
  sizeBytes Int    @map("size_bytes")

  /// Utente che ha caricato l'allegato (FK obbligatoria: un caricamento è
  /// sempre un'azione di un utente autenticato, mai anonima).
  caricatoDa   String   @map("caricato_da") @db.Uuid
  caricatoAlle DateTime @default(now()) @map("caricato_alle")

  fir              FIR  @relation(fields: [firId, tenantId], references: [id, tenantId], onDelete: Cascade)
  caricatoDaUtente User @relation(fields: [caricatoDa], references: [id])

  // Un allegato dell'ente non può comparire due volte per lo stesso FIR:
  // stessa cautela già applicata a `[tenantId, rentriNumeroFir]` sul FIR.
  @@unique([firId, rentriAllegatoId])
  @@index([tenantId])
  @@index([firId])
  @@map("fir_allegati_rentri")
}

enum RENTRISyncLogStatus {
  PENDING
  SUCCESS
  FAILURE

  @@map("rentri_sync_log_status")
}

/// V. commento sul campo RENTRISyncLog.origine.
enum RENTRISyncLogOrigine {
  TRASMISSIONE
  RICONCILIAZIONE

  @@map("rentri_sync_log_origine")
}

/// Fase 2 pezzo 5: ruolo di una causale nel MUD.
enum RuoloMudCausale {
  PRODOTTO
  AVVIATO
  RICEVUTO_DA_TERZI
  ESCLUSO

  @@map("ruolo_mud_causale")
}

/// Fase 2 pezzo 5: PROPRIA = causale creata dall'azienda (una riga per versione);
/// DISATTIVAZIONE = una causale di sistema resa non selezionabile per l'azienda.
enum NaturaCausaleAzienda {
  PROPRIA
  DISATTIVAZIONE

  @@map("natura_causale_azienda")
}

/// Catalogo di sistema delle causali del registro (Fase 2 pezzo 5). GLOBALE: niente `tenant_id`,
/// niente RLS. Lo scrive solo la migration (owner); l'applicazione ha solo SELECT (vedi
/// prisma/sql/ruoli-db.sql). `verso`, `ruolo_mud` e `operazione` di una riga non cambiano mai.
model CausaleRegistro {
  codice       String            @db.VarChar(100)
  verso        WasteMovementType
  descrizione  String            @db.VarChar(200)
  ruoloMud     RuoloMudCausale   @map("ruolo_mud")
  /// Causale RENTRI (contratto CausaliOperazione); NULL = non trasmissibile.
  codiceRentri String?           @map("codice_rentri") @db.VarChar(5)
  /// R/D solo per gli scarichi avviati a recupero o smaltimento.
  operazione   String?           @db.VarChar(1)
  ordine       Int               @db.SmallInt
  attiva       Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")

  disattivazioni CausaleRegistroAzienda[] @relation("DisattivazioniSistema")

  @@id([codice, verso], map: "causali_registro_pkey")
  @@map("causali_registro")
}

/// Personalizzazioni per azienda (Fase 2 pezzo 5): causali PROPRIE (con versioni) e
/// DISATTIVAZIONI di causali di sistema. RLS per tenant.
model CausaleRegistroAzienda {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  natura               NaturaCausaleAzienda
  codice               String               @db.VarChar(100)
  verso                WasteMovementType
  causaleSistemaCodice String?              @map("causale_sistema_codice") @db.VarChar(100)
  descrizione          String?              @db.VarChar(200)
  ruoloMud             RuoloMudCausale?     @map("ruolo_mud")
  codiceRentri         String?              @map("codice_rentri") @db.VarChar(5)
  operazione           String?              @db.VarChar(1)
  ordine               Int                  @default(100) @db.SmallInt
  validaDal            DateTime?            @map("valida_dal") @db.Date
  validaAl             DateTime?            @map("valida_al") @db.Date
  creatoDa             String               @map("creato_da") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  causaleSistema CausaleRegistro? @relation("DisattivazioniSistema", fields: [causaleSistemaCodice, verso], references: [codice, verso], onDelete: Restrict, onUpdate: Cascade, map: "causali_registro_azienda_sistema_fkey")
  movimenti      WasteMovement[]  @relation("MovimentiCausale")

  @@unique([id, tenantId], map: "causali_registro_azienda_id_tenant_id_key")
  @@unique([id, tenantId, codice, verso], map: "causali_registro_azienda_id_tenant_codice_verso_key")
  @@unique([tenantId, codice, verso, validaDal], map: "causali_registro_azienda_versione_key")
  @@unique([tenantId, causaleSistemaCodice, verso], map: "causali_registro_azienda_disattivazione_key")
  @@index([tenantId], map: "causali_registro_azienda_tenant_id_idx")
  @@map("causali_registro_azienda")
}

/// Controparte dell'azienda (Fase 2 pezzo 10): identita' fiscale e ragione sociale. Una ditta puo'
/// essere produttore, trasportatore e destinatario (una riga di ruolo ciascuno, stessi id di
/// sempre). Identificata da partita IVA o codice fiscale (un privato ha il solo codice fiscale).
/// Il checksum non sta nel database (le P.IVA migrate non sono mai state controllate): lo applica
/// l'applicazione quando un identificativo viene impostato. RLS per tenant.
model Ditta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ragioneSociale String   @map("ragione_sociale") @db.VarChar(255)
  partitaIva     String?  @map("partita_iva") @db.VarChar(11)
  codiceFiscale  String?  @map("codice_fiscale") @db.VarChar(16)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sedi          SedeDitta[]
  produttori    Produttore[]
  trasportatori Trasportatore[]
  destinatari   Destinatario[]

  @@unique([id, tenantId], map: "ditte_id_tenant_id_key")
  @@unique([tenantId, partitaIva], map: "ditte_tenant_id_partita_iva_key")
  @@unique([tenantId, codiceFiscale], map: "ditte_tenant_id_codice_fiscale_key")
  @@index([tenantId], map: "ditte_tenant_id_idx")
  @@map("ditte")
}

/// Sede di una ditta (Fase 2 pezzo 10): indirizzo e contatti. Esattamente una principale per
/// ditta ("al piu' una" nel database con l'indice parziale `sedi_ditte_una_principale`, solo SQL).
/// Le sedi non si cancellano: si disattivano. RLS per tenant.
model SedeDitta {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  dittaId       String   @map("ditta_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  denominazione String?  @db.VarChar(255)
  via           String   @db.VarChar(255)
  civico        String   @db.VarChar(20)
  cap           String   @db.VarChar(5)
  comune        String   @db.VarChar(100)
  provincia     String   @db.VarChar(2)
  referente     String?  @db.VarChar(255)
  email         String?  @db.VarChar(255)
  telefono      String?  @db.VarChar(20)
  pec           String?  @db.VarChar(255)
  principale    Boolean  @default(false)
  attiva        Boolean  @default(true)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ditta         Ditta           @relation(fields: [dittaId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "sedi_ditte_ditta_fkey")
  produttori    Produttore[]
  trasportatori Trasportatore[]
  destinatari   Destinatario[]

  @@unique([id, tenantId], map: "sedi_ditte_id_tenant_id_key")
  @@unique([id, dittaId, tenantId], map: "sedi_ditte_id_ditta_id_tenant_id_key")
  @@index([tenantId], map: "sedi_ditte_tenant_id_idx")
  @@index([dittaId], map: "sedi_ditte_ditta_id_idx")
  @@map("sedi_ditte")
}

/// Criterio di controllo del deposito temporaneo scelto dall'azienda (art. 185-bis D.Lgs. 152/2006):
/// la norma lascia scegliere fra il limite di tempo (tre mesi) e quello di quantita'.
enum CriterioDepositoTemporaneo {
  NON_SCELTO
  TEMPORALE
  QUANTITATIVO

  @@map("criterio_deposito_temporaneo")
}

/// Soglie del deposito temporaneo (Fase 2 pezzo 6). `registro_id` NULL = soglie dell'azienda,
/// altrimenti quelle di un registro (sede). Nessuna riga = valori predefiniti del codice
/// (SOGLIE_PREDEFINITE); precedenza per riga intera: registro, azienda, predefinite.
/// `giorni_max` NULL = nessuna soglia aggiuntiva ai tre mesi di legge. `kg_max_totale` e
/// `kg_max_pericolosi` sono la conversione in kg, indicata dall'azienda, dei 30 m3 (10 m3 di
/// pericolosi) della norma; `note` serve a scriverla.
/// La migration aggiunge i CHECK sui valori (stessi range di `validaSoglie`) e l'indice unico
/// parziale `soglie_deposito_temporaneo_una_per_azienda` (una sola riga con registro_id NULL per
/// azienda): Prisma non lo conosce, quindi `migrate diff` resta pulito.
model SogliaDepositoTemporaneo {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  registroId           String?                    @map("registro_id") @db.Uuid
  criterio             CriterioDepositoTemporaneo
  giorniMax            Int?                       @map("giorni_max") @db.SmallInt
  kgMaxTotale          Decimal                    @map("kg_max_totale") @db.Decimal(12, 2)
  kgMaxPericolosi      Decimal                    @map("kg_max_pericolosi") @db.Decimal(12, 2)
  preavvisoGiorni      Int                        @map("preavviso_giorni") @db.SmallInt
  preavvisoPercentuale Int                        @map("preavviso_percentuale") @db.SmallInt
  note                 String?                    @db.VarChar(500)
  impostatoDa          String                     @map("impostato_da") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registro RegistroRifiuti? @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "soglie_deposito_temporaneo_registro_fkey")

  @@unique([id, tenantId], map: "soglie_deposito_temporaneo_id_tenant_id_key")
  @@unique([tenantId, registroId], map: "soglie_deposito_temporaneo_tenant_id_registro_id_key")
  @@index([tenantId], map: "soglie_deposito_temporaneo_tenant_id_idx")
  @@map("soglie_deposito_temporaneo")
}

// ---------------------------------------------------------------------------------------------
// Pese (Fase 4 pezzo 8a): strumenti, automezzi, accessi, pesate, rettifiche, allegati, collegamenti.
// Le regole di immutabilita' stanno nei trigger della migration `20261101400000_pese_modello_dati`
// e nei privilegi di `prisma/sql/ruoli-db.sql`; i CHECK e gli indici unici parziali (solo SQL)
// non sono dichiarati qui: Prisma non li conosce, quindi `migrate diff` resta pulito.
// ---------------------------------------------------------------------------------------------

/// Da dove viene il peso di una pesata. TARA_ANAGRAFICA = tara dichiarata dell'automezzo, non una pesata vera.
enum FontePesata {
  STRUMENTO
  FILE
  MANUALE
  TARA_ANAGRAFICA

  @@map("fonte_pesata")
}

/// Come si ottiene il netto di un accesso: due pesate, una pesata + tara dichiarata, una pesata singola.
enum ModoPesatura {
  DOPPIA
  TARA_ANAGRAFICA
  SINGOLA

  @@map("modo_pesatura")
}

enum StatoAccessoPesa {
  APERTO
  CHIUSO
  ANNULLATO

  @@map("stato_accesso_pesa")
}

enum OrigineTara {
  DICHIARATA
  PESATA

  @@map("origine_tara")
}

enum TipoCollegamentoAccesso {
  FIR
  MOVIMENTO

  @@map("tipo_collegamento_accesso")
}

/// Anagrafica degli strumenti di pesatura (bilance) dell'azienda, per sede (`registro_id`).
/// Mutabile, mai cancellata (nessuna DELETE per i ruoli DB, `ruoli-db.sql`). Il CHECK
/// `strumenti_pesa_valori_check` (portata e divisione > 0, descrizione non vuota) sta nella migration.
model StrumentoPesa {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  registroId              String?   @map("registro_id") @db.Uuid
  descrizione             String    @db.VarChar(255)
  costruttore             String?   @db.VarChar(100)
  modello                 String?   @db.VarChar(100)
  matricola               String?   @db.VarChar(100)
  portataMaxKg            Decimal?  @map("portata_max_kg") @db.Decimal(10, 2)
  divisioneKg             Decimal?  @map("divisione_kg") @db.Decimal(8, 3)
  dataUltimaVerificazione DateTime? @map("data_ultima_verificazione") @db.Date
  attivo                  Boolean   @default(true)
  creatoDa                String    @map("creato_da") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registro RegistroRifiuti? @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "strumenti_pesa_registro_fkey")
  pesate   Pesata[]

  @@unique([id, tenantId], map: "strumenti_pesa_id_tenant_id_key")
  @@unique([tenantId, matricola], map: "strumenti_pesa_tenant_id_matricola_key")
  @@index([tenantId], map: "strumenti_pesa_tenant_id_idx")
  @@map("strumenti_pesa")
}

/// Anagrafica degli automezzi (targa + rimorchio) con la tara dichiarata. Mutabile, mai cancellata.
/// La tara e' tutta o niente (`automezzi_tara_check`); l'indice unico `automezzi_targhe_uniche`
/// (tenant, targa, rimorchio) e' solo SQL.
model Automezzo {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  targa               String       @db.VarChar(15)
  targaRimorchio      String?      @map("targa_rimorchio") @db.VarChar(15)
  trasportatoreId     String?      @map("trasportatore_id") @db.Uuid
  taraKg              Decimal?     @map("tara_kg") @db.Decimal(10, 2)
  taraOrigine         OrigineTara? @map("tara_origine")
  taraPesataId        String?      @map("tara_pesata_id") @db.Uuid
  taraAggiornataIl    DateTime?    @map("tara_aggiornata_il") @db.Timestamptz(3)
  ultimaPesataVuotoIl DateTime?    @map("ultima_pesata_vuoto_il") @db.Timestamptz(3)
  note                String?      @db.VarChar(500)
  attivo              Boolean      @default(true)
  creatoDa            String       @map("creato_da") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trasportatore Trasportatore? @relation(fields: [trasportatoreId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "automezzi_trasportatore_fkey")
  taraPesata    Pesata?        @relation("TaraAutomezzo", fields: [taraPesataId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "automezzi_tara_pesata_fkey")
  accessi       AccessoPesa[]
  pesate        Pesata[]       @relation("PesateAutomezzo")

  @@unique([id, tenantId], map: "automezzi_id_tenant_id_key")
  @@index([tenantId], map: "automezzi_tenant_id_idx")
  @@map("automezzi")
}

/// Un passaggio di un mezzo sulla pesa, in un registro (sede), con numero `N/AAAA` per registro.
/// Sono modificabili solo stato e campi descrittivi mentre APERTO: la regola sta nel trigger
/// `accessi_pesa_controlli`. Mai cancellato (`ruoli-db.sql`).
model AccessoPesa {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  registroId         String            @map("registro_id") @db.Uuid
  anno               Int               @db.SmallInt
  numero             Int
  verso              WasteMovementType
  modo               ModoPesatura
  stato              StatoAccessoPesa  @default(APERTO)
  automezzoId        String?           @map("automezzo_id") @db.Uuid
  targa              String?           @db.VarChar(15)
  targaRimorchio     String?           @map("targa_rimorchio") @db.VarChar(15)
  cerCode            String?           @map("cer_code") @db.VarChar(10)
  descrizione        String?           @db.VarChar(255)
  note               String?           @db.VarChar(1000)
  apertoDa           String            @map("aperto_da") @db.Uuid
  apertoIl           DateTime          @default(now()) @map("aperto_il") @db.Timestamptz(3)
  chiusoDa           String?           @map("chiuso_da") @db.Uuid
  chiusoIl           DateTime?         @map("chiuso_il") @db.Timestamptz(3)
  annullatoDa        String?           @map("annullato_da") @db.Uuid
  annullatoIl        DateTime?         @map("annullato_il") @db.Timestamptz(3)
  motivoAnnullamento String?           @map("motivo_annullamento") @db.VarChar(500)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registro     RegistroRifiuti       @relation(fields: [registroId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "accessi_pesa_registro_fkey")
  automezzo    Automezzo?            @relation(fields: [automezzoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "accessi_pesa_automezzo_fkey")
  pesate       Pesata[]
  collegamenti CollegamentoAccesso[]

  @@unique([id, tenantId], map: "accessi_pesa_id_tenant_id_key")
  @@index([automezzoId], map: "accessi_pesa_automezzo_id_idx")
  @@unique([registroId, anno, numero], map: "accessi_pesa_registro_id_anno_numero_key")
  @@unique([id, registroId, tenantId, verso], map: "accessi_pesa_id_registro_tenant_verso_key")
  @@index([tenantId], map: "accessi_pesa_tenant_id_idx")
  @@map("accessi_pesa")
}

/// Una pesata di un accesso. MAI modificata ne' cancellata: trigger `pesate_immutabile`, privilegi
/// solo SELECT e INSERT. Coerenza fonte/modo/ordine nei CHECK `pesate_coerenza_check` e nel trigger
/// `pesate_controlli`. `impronta` = SHA-256 della riga (`domain/pese/impronta-pesata.ts`).
model Pesata {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  accessoId         String      @map("accesso_id") @db.Uuid
  ordine            Int         @db.SmallInt
  fonte             FontePesata
  strumentoId       String?     @map("strumento_id") @db.Uuid
  strumentoEsterno  String?     @map("strumento_esterno") @db.VarChar(200)
  alibiId           String?     @map("alibi_id") @db.VarChar(40)
  pesoKg            Decimal     @map("peso_kg") @db.Decimal(10, 2)
  stabile           Boolean
  oraStrumento      DateTime?   @map("ora_strumento") @db.Timestamptz(3)
  oraRicezione      DateTime    @map("ora_ricezione") @db.Timestamptz(3)
  operatoreId       String?     @map("operatore_id") @db.Uuid
  motivoManuale     String?     @map("motivo_manuale") @db.VarChar(500)
  allegatoId        String?     @map("allegato_id") @db.Uuid
  automezzoId       String?     @map("automezzo_id") @db.Uuid
  taraAggiornataIl  DateTime?   @map("tara_aggiornata_il") @db.Timestamptz(3)
  chiaveIdempotenza String      @map("chiave_idempotenza") @db.Uuid
  firmaAgente       String?     @map("firma_agente")
  impronta          String      @db.VarChar(64)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accesso       AccessoPesa     @relation(fields: [accessoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "pesate_accesso_fkey")
  strumento     StrumentoPesa?  @relation(fields: [strumentoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "pesate_strumento_fkey")
  allegato      AllegatoPesa?   @relation(fields: [allegatoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "pesate_allegato_fkey")
  automezzo     Automezzo?      @relation("PesateAutomezzo", fields: [automezzoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "pesate_automezzo_fkey")
  automezziTara Automezzo[]     @relation("TaraAutomezzo")
  rettifiche    RettificaPeso[]

  @@unique([id, tenantId], map: "pesate_id_tenant_id_key")
  @@unique([accessoId, ordine], map: "pesate_accesso_id_ordine_key")
  @@unique([tenantId, chiaveIdempotenza], map: "pesate_tenant_id_chiave_idempotenza_key")
  @@unique([strumentoId, alibiId], map: "pesate_strumento_id_alibi_id_key")
  @@index([allegatoId], map: "pesate_allegato_id_idx")
  @@index([automezzoId], map: "pesate_automezzo_id_idx")
  @@index([tenantId], map: "pesate_tenant_id_idx")
  @@map("pesate")
}

/// Rettifica di un peso: la pesata originale non cambia mai, vale l'ultima rettifica per `numero`.
/// MAI modificata ne' cancellata (trigger `rettifiche_peso_immutabile`); numerazione e peso
/// precedente controllati da `rettifiche_peso_controlli`.
model RettificaPeso {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  pesataId         String   @map("pesata_id") @db.Uuid
  numero           Int      @db.SmallInt
  pesoPrecedenteKg Decimal  @map("peso_precedente_kg") @db.Decimal(10, 2)
  pesoNuovoKg      Decimal  @map("peso_nuovo_kg") @db.Decimal(10, 2)
  motivo           String   @db.VarChar(500)
  autoreId         String   @map("autore_id") @db.Uuid
  allegatoId       String?  @map("allegato_id") @db.Uuid
  impronta         String   @db.VarChar(64)
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pesata   Pesata        @relation(fields: [pesataId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "rettifiche_peso_pesata_fkey")
  allegato AllegatoPesa? @relation(fields: [allegatoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "rettifiche_peso_allegato_fkey")

  @@unique([id, tenantId], map: "rettifiche_peso_id_tenant_id_key")
  @@unique([pesataId, numero], map: "rettifiche_peso_pesata_id_numero_key")
  @@index([tenantId], map: "rettifiche_peso_tenant_id_idx")
  @@map("rettifiche_peso")
}

/// Foto o PDF dello scontrino, nel database (max 4 MiB, JPEG/PNG/PDF verificati dai magic bytes
/// dall'applicazione). MAI modificato ne' cancellato (`allegati_pesa_immutabile`).
model AllegatoPesa {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  nomeFile       String   @map("nome_file") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(50)
  dimensioneByte Int      @map("dimensione_byte")
  sha256         String   @db.VarChar(64)
  contenuto      Bytes
  caricatoDa     String   @map("caricato_da") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pesate     Pesata[]
  rettifiche RettificaPeso[]

  @@unique([id, tenantId], map: "allegati_pesa_id_tenant_id_key")
  @@index([tenantId], map: "allegati_pesa_tenant_id_idx")
  @@map("allegati_pesa")
}

/// Collegamento di un accesso CHIUSO a un FIR o a un'annotazione di registro. Si puo' solo
/// revocare (una volta): trigger `collegamenti_accesso_controlli`. Le FK composte impongono stessa
/// azienda, stesso registro e verso uguale al tipo del movimento; gli indici unici parziali
/// (un collegamento attivo per accesso, per FIR e per movimento) sono solo SQL.
model CollegamentoAccesso {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  accessoId    String                  @map("accesso_id") @db.Uuid
  registroId   String                  @map("registro_id") @db.Uuid
  verso        WasteMovementType
  tipo         TipoCollegamentoAccesso
  firId        String?                 @map("fir_id") @db.Uuid
  movimentoId  String?                 @map("movimento_id") @db.Uuid
  creatoDa     String                  @map("creato_da") @db.Uuid
  creatoIl     DateTime                @default(now()) @map("creato_il") @db.Timestamptz(3)
  revocatoDa   String?                 @map("revocato_da") @db.Uuid
  revocatoIl   DateTime?               @map("revocato_il") @db.Timestamptz(3)
  motivoRevoca String?                 @map("motivo_revoca") @db.VarChar(500)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accesso   AccessoPesa    @relation(fields: [accessoId, registroId, tenantId, verso], references: [id, registroId, tenantId, verso], onDelete: NoAction, onUpdate: NoAction, map: "collegamenti_accesso_accesso_fkey")
  movimento WasteMovement? @relation(fields: [movimentoId, registroId, tenantId, verso], references: [id, registroId, tenantId, type], onDelete: NoAction, onUpdate: NoAction, map: "collegamenti_accesso_movimento_fkey")
  fir       FIR?           @relation(fields: [firId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction, map: "collegamenti_accesso_fir_fkey")

  @@unique([id, tenantId], map: "collegamenti_accesso_id_tenant_id_key")
  @@index([tenantId], map: "collegamenti_accesso_tenant_id_idx")
  @@index([firId, tenantId], map: "collegamenti_accesso_fir_id_tenant_id_idx")
  @@index([movimentoId, registroId, tenantId, verso], map: "collegamenti_accesso_movimento_idx")
  @@map("collegamenti_accesso")
}
