# ============================================================================
# Frontend Angular 17 (+ app campo Angular 21 sotto /campo/) — immagine di produzione (multi-stage, lean)
# ----------------------------------------------------------------------------
# Il frontend e' un workspace npm SENZA lockfile proprio: le dipendenze sono
# gestite alla ROOT del monorepo. Per questo il contesto di build e' la root
# del repo (non apps/frontend). Lo stage builder compila la SPA; lo stage
# runtime e' un nginx:alpine che serve i file statici e fa da proxy /api.
# ============================================================================

# --- Stage 1: build ---------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /repo

# Manifest prima dei sorgenti per massimizzare la cache di layer su `npm ci`.
# Servono i package.json di TUTTI i workspace referenziati dal lockfile,
# altrimenti `npm ci` fallisce ("workspace not found").
COPY package.json package-lock.json ./
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/backend/package.json apps/backend/package.json

RUN npm ci

# Sorgenti frontend + build di produzione (configuration "production" di default)
COPY apps/frontend apps/frontend
RUN npm run build --workspace @wasteflow/frontend

# App campo (PWA autisti, Angular 21): NON e' un workspace npm della radice, ha il suo lock.
# Stesso Node 20 (Angular 21 richiede >= 20.19; node:20-alpine e' 20.x recente).
COPY apps/campo/package.json apps/campo/package-lock.json apps/campo/
RUN cd apps/campo && npm ci
COPY apps/campo apps/campo
RUN cd apps/campo && npm run build

# --- Stage 2: runtime -------------------------------------------------------
FROM nginx:alpine

# Rimuove la pagina di default e copia la SPA compilata
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /repo/apps/frontend/dist/frontend /usr/share/nginx/html
# App campo sotto /campo/ (baseHref /campo/, vedi nginx.conf)
COPY --from=builder /repo/apps/campo/dist/campo/browser /usr/share/nginx/html/campo
COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Installa curl per l'healthcheck (lightweight, ~2MB aggiunto)
RUN apk add --no-cache curl

EXPOSE 80

# Healthcheck robusto: curl -fsSI fa una HEAD request senza scaricare il corpo,
# exit 0 se nginx risponde (2xx/3xx), exit 1 altrimenti.
# start-period=15s dà tempo a nginx di inizializzare prima del primo controllo.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsSI http://localhost/ > /dev/null || exit 1
